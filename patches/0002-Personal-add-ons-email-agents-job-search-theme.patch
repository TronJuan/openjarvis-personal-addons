+"""Deterministic parts of the personal agents (no model or network calls)."""
+
+from __future__ import annotations
+
+from datetime import timedelta
+from pathlib import Path
+
+import pytest
+
+from openjarvis.personal import eventmate, jobs
+from openjarvis.personal.store import (PersonalStore, load_settings, load_whitelist,
+                                       now_local, save_settings, save_whitelist)
+
+RESUME = """## Alex Example
+
+Springfield
+
+### Profile
+
+Old profile paragraph.
+
+### Technical Projects
+
+**Alpha Project** — 2026
+- did alpha
+
+**Beta Project** — 2026
+- did beta
+
+### Experience
+
+**Freelance Photographer** — 2026
+"""
+
+
+def _email(sender="x@example.com", subject="", body=""):
+    return eventmate.Email(doc_id="d", account="a@gmail.com", sender=sender,
+                           subject=subject, received_at="", url="", body=body)
+
+
+WHITELIST = {"sender_domains": ["example.edu"], "keywords": ["workshop", "rsvp"]}
+
+
+@pytest.mark.parametrize("email, expected", [
+    (_email(sender="Club <club@example.edu>"), True),
+    (_email(sender="Club <club@students.example.edu>"), True),
+    (_email(sender="Spoof <x@notexample.edu>"), False),
+    (_email(subject="Resume workshop on Tuesday"), True),
+    (_email(body="Please RSVP by Friday"), True),
+    (_email(subject="Workshops"), False),  # whole words only
+    (_email(subject="Your order has shipped"), False),
+])
+def test_whitelist_matching(email, expected):
+    assert eventmate.matches_whitelist(email, WHITELIST) is expected
+
+
+def test_whitelist_round_trip_normalises():
+    save_whitelist({"sender_domains": [" @Example.EDU ", ""],
+                    "keywords": ["RSVP", "rsvp", " "]})
+    assert load_whitelist() == {"sender_domains": ["example.edu"],
+                                "keywords": ["rsvp"]}
+
+
+def test_plain_text_strips_html():
+    body = ("<p style='x'>Hello&nbsp;there</p><script>evil()</script>"
+            "<br>Line two &amp; more")
+    assert eventmate._plain_text(body) == "Hello there\n\nLine two & more"
+    assert eventmate._plain_text("already plain") == "already plain"
+
+
+def test_event_upsert_fills_blanks_only(tmp_path):
+    with PersonalStore(tmp_path / "p.db") as store:
+        first = store.upsert_event({"name": "CTF Night", "organisation": "MonSec",
+                                    "date": "2026-10-07", "location": ""})
+        store.update_event(first, status="Enrolled")
+        again = store.upsert_event({"name": "ctf  night!", "organisation": "monsec",
+                                    "date": "2026-10-07", "location": "Clayton"})
+        row = store.find_event_by_name("CTF Night")
+    assert again == first
+    assert row["location"] == "Clayton"
+    assert row["status"] == "Enrolled"
+
+
+def test_load_resume_falls_back_and_blocks_never_mention_terms():
+    with pytest.raises(ValueError, match="No resume yet"):
+        jobs.load_resume("it", load_settings())
+    jobs.save_resume("business", RESUME)
+    assert jobs.load_resume("it", load_settings()) == RESUME.strip()
+
+    settings = save_settings({"never_mention": ["Freelance Photographer"]})
+    with pytest.raises(ValueError, match="never-mention"):
+        jobs.load_resume("business", settings)
+
+
+def test_tailor_resume_swaps_profile_and_reorders_projects():
+    jobs.save_resume("it", RESUME)
+    body = jobs.load_resume("it", load_settings())
+    out = jobs.tailor_resume(body, "New profile.", ["Beta Project"])
+    assert "New profile." in out and "Old profile" not in out
+    assert out.index("**Beta Project**") < out.index("**Alpha Project**")
+    assert "**Freelance Photographer**" in out
+    # Unknown titles leave the order unchanged and drop nothing.
+    same = jobs.tailor_resume(body, "", ["Not a project"])
+    assert same.index("**Alpha Project**") < same.index("**Beta Project**")
+    assert "Old profile paragraph." in same
+
+
+def test_parse_results():
+    content = ("### Role A\nSource: https://a.example/job\nSummary: first\n\n---\n\n"
+               "### Bad\nSource: not-a-url\nSummary: skip")
+    assert jobs.parse_results(content) == [
+        {"title": "Role A", "url": "https://a.example/job", "snippet": "first"}
+    ]
+
+
+def test_expand_listing_extracts_board_links(monkeypatch):
+    page = (
+        '<a href="/employers/ey/jobs/ey-vacationer-tech/">EY Vacationer</a>'
+        '<a href="/job/123?type=promoted&amp;origin=jobCard"></a>'
+        '<a href="/job/123?type=promoted&amp;origin=cardTitle">Junior Analyst</a>'
+        '<a href="/about">About</a>'
+    )
+    monkeypatch.setattr(jobs, "fetch_html", lambda url: page)
+    roles = jobs.expand_listing("https://au.gradconnection.com/internships/")
+    assert {r["url"]: r["title"] for r in roles} == {
+        "https://au.gradconnection.com/employers/ey/jobs/ey-vacationer-tech/":
+            "EY Vacationer",
+        "https://au.gradconnection.com/job/123": "Junior Analyst",
+    }
+
+
+def test_excluded_terms_come_from_settings():
+    assert jobs._excluded({"never_mention": []}) is None
+    pattern = jobs._excluded({"never_mention": ["Old Job Co", " ", "a.b"]})
+    assert pattern.search("Waiter at old job co")
+    assert not pattern.search("axb")  # terms are literal, not regex
+
+
+def test_signoff_uses_profile():
+    assert "leave the name blank" in jobs._signoff(load_settings())
+    settings = save_settings({"profile": {"name": "Alex Example", "email": "alex@example.com"}})
+    assert jobs._signoff(settings) == "Sign off as Alex Example (alex@example.com)."
+
+
+def test_dashboard_filters(tmp_path):
+    with PersonalStore(Path(tmp_path) / "p.db") as store:
+        store.add_job({"url": "https://x/1", "kind": "posting", "fit": 80})
+        store.add_job({"url": "https://x/2", "kind": "listing_page"})
+        store.add_deadline("2000-01-01", "long gone", "email")
+        data = store.dashboard()
+    assert [j["url"] for j in data["jobs"]] == ["https://x/1"]
+    assert data["deadlines"] == []
+
+
+def test_fit_score_sums_caps_and_restricts():
+    assert jobs.fit_score({"eligible": 30, "field_match": 30,
+                           "skills_match": 25, "practical": 15}) == 100
+    assert jobs.fit_score({"eligible": 99, "field_match": "x",
+                           "skills_match": -5, "practical": 10}) == 40
+    assert jobs.fit_score({"eligible": 30, "field_match": 30, "skills_match": 25,
+                           "practical": 15, "restricted": True}) == 20
+
+
+def test_pick_for_drafts_one_per_company():
+    cands = [({"company": c, "fit": f}, {}) for c, f in
+             [("EY", 90), ("E.Y.", 88), ("KPMG", 85), ("ey", 80), ("", 79), ("", 78)]]
+    picked = [j["company"] for j, _ in jobs.pick_for_drafts(cands, 4)]
+    assert picked == ["EY", "E.Y.", "KPMG", ""]  # unknown companies never collide
+    assert len(jobs.pick_for_drafts(cands, 2)) == 2
+
+
+def test_unsupported_numbers():
+    sources = "Placed 3rd of 18 teams; 33 automated tests; 10.6 years"
+    letter = "I wrote 33 tests over 10.6 years, found 5 defects, placed 3rd of 20."
+    assert jobs.unsupported_numbers(letter, sources) == ["5", "20"]
+
+
+def test_fit_score_caps_ineligible():
+    full = {"eligible": 0, "field_match": 30, "skills_match": 25, "practical": 15}
+    assert jobs.fit_score(full) == 20
+
+
+def _posting(**fields):
+    return dict({"title": "", "work_period": "", "description": "", "job_type": "",
+                 "region": "", "location": ""}, **fields)
+
+
+EXCLUDE = {"exclude_phrases": ["2026/27", "Security clearance", " "]}
+
+
+@pytest.mark.parametrize("job, reason", [
+    (_posting(title="2026/27 Vacationer Program – Technology"), "2026/27"),
+    (_posting(title="Graduate", description="Requires a SECURITY CLEARANCE"), "Security clearance"),
+    (_posting(title="Intern", work_period="2026/27 summer"), "2026/27"),
+])
+def test_ineligible_reason_flags(job, reason):
+    assert reason in jobs.ineligible_reason(job, EXCLUDE)
+
+
+@pytest.mark.parametrize("job", [
+    _posting(title="2027/28 Summer Intern Program", job_type="internship"),
+    _posting(title="Software Engineer Intern", job_type="internship"),
+])
+def test_ineligible_reason_allows(job):
+    assert jobs.ineligible_reason(job, EXCLUDE) == ""
+    assert jobs.ineligible_reason(_posting(title="2026/27 Program"), {"exclude_phrases": []}) == ""
+
+
+def test_stated_months():
+    assert jobs.stated_months("Jun-Jul 2027") == {6, 7}
+    assert jobs.stated_months("Dec 2026 - Feb 2027") == {12, 1, 2}
+    assert jobs.stated_months("January 2027 - May 2027") == {1, 2, 3, 4, 5}
+    assert jobs.stated_months("") == set()
+
+
+def test_apply_eligibility_caps_and_explains():
+    job = _posting(title="2026/27 Graduate Program", job_type="graduate", fit=90,
+                   why="Strong match.")
+    assert jobs.apply_eligibility(job, EXCLUDE)
+    assert job["fit"] == 20
+    assert job["why"].startswith('Ineligible: mentions "2026/27"')
+    assert job["why"].endswith("Strong match.")
+    assert jobs.apply_eligibility(job, EXCLUDE)  # idempotent: no second prefix
+    assert job["why"].count("Ineligible:") == 1
+    low = _posting(title="2026/27 Graduate Program", job_type="graduate", fit=12, why="")
+    jobs.apply_eligibility(low, EXCLUDE)
+    assert low["fit"] == 12
+    fine = _posting(title="Casual Barista", job_type="casual", fit=60, why="")
+    assert not jobs.apply_eligibility(fine, EXCLUDE) and fine["fit"] == 60
+
+
+def test_recap_stored_caps_rows_and_drops_deadlines(tmp_path):
+    save_settings(EXCLUDE)
+    with PersonalStore(tmp_path / "p.db") as store:
+        store.add_job(_posting(url="https://x/grad", kind="posting", fit=90, why="",
+                               title="2026/27 Graduate Program", job_type="graduate"))
+        store.add_job(_posting(url="https://x/ok", kind="posting", fit=70, why="",
+                               title="2027/28 Summer Intern", job_type="internship"))
+        soon = (now_local() + timedelta(days=5)).date().isoformat()
+        store.add_deadline(soon, "Applications close: grad", "job", "https://x/grad")
+        store.add_deadline(soon, "Applications close: ok", "job", "https://x/ok")
+        capped = jobs.recap_stored(store)
+        fits = {j["url"]: j["fit"] for j in store.postings()}
+        deadlines = [d["ref"] for d in store.dashboard()["deadlines"]]
+    assert [(c["url"], c["fit_before"]) for c in capped] == [("https://x/grad", 90)]
+    assert fits == {"https://x/grad": 20, "https://x/ok": 70}
+    assert deadlines == ["https://x/ok"]
+
+
+def test_trim_to_title():
+    text = "Home Jobs Login Software Engineer Intern at ACS. Apply now"
+    assert jobs.trim_to_title("Software Engineer Intern", text).startswith("Software Engineer Intern")
+    assert jobs.trim_to_title("Missing", text) == text
+
+
+def test_read_drafts(tmp_path):
+    p = tmp_path / "d.md"
+    p.write_text("---\n---\n# T\n\n## Tailored resume\n\n## Alex\nR\n## Cover letter\n\nDear team", encoding="utf-8")
+    assert jobs.read_drafts(str(p)) == {"resume": "## Alex\nR", "cover_letter": "Dear team"}
+    assert jobs.read_drafts(str(tmp_path / "none.md")) == {"resume": "", "cover_letter": ""}
+
+
+def test_eventmate_runs_before_any_mail_is_synced():
+    stats = eventmate.run(sync=False)
+    assert stats["new_emails"] == 0 and stats["errors"] == 0
