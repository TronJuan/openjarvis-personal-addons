+          <Panel icon={CalendarDays} title="Events" color={EVENTS_BLUE} fill={22} className="flex-1">
+            <div className="flex-1 min-h-0 overflow-y-auto flex flex-col gap-2">
+              {data && events.length === 0 && <Empty>No upcoming events.</Empty>}
+              {events.map((e) => (
+                <Link key={e.id} to={`/events?id=${e.id}`} className={rowClass} style={rowStyle}>
+                  <Row primary={e.name} secondary={e.organisation}
+                       right={[shortDate(e.date), e.start_time].filter(Boolean).join(' · ')} />
+                </Link>
+              ))}
+            </div>
+          </Panel>
+
+          <Panel icon={Briefcase} title="Jobs and internships" color={JOBS_BLUE} fill={32} className="flex-1">
+            <div className="flex-1 min-h-0 overflow-y-auto flex flex-col gap-2">
+              {data && jobs.length === 0 && <Empty>No job leads yet.</Empty>}
+              {jobs.map((j) => (
+                <Link key={j.id} to={`/jobs?id=${j.id}`} className={rowClass} style={rowStyle}>
+                  <Row primary={j.company || 'Unknown company'} secondary={j.title} />
+                </Link>
+              ))}
+            </div>
+          </Panel>
+        </div>
+      </div>
+    </div>
+  );
+}
