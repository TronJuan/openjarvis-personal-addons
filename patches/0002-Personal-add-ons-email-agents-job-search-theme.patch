diff --git a/frontend/src/pages/EmailsPage.tsx b/frontend/src/pages/EmailsPage.tsx
new file mode 100644
index 00000000..ed2615b3
--- /dev/null
+++ b/frontend/src/pages/EmailsPage.tsx
@@ -0,0 +1,277 @@
+import { useEffect, useState } from 'react';
+import { ExternalLink, Inbox, Loader2, Mail, Search } from 'lucide-react';
+import { apiFetch } from '../lib/api';
+
+interface EmailSummary {
+  doc_id: string;
+  account: string;
+  sender: string;
+  subject: string;
+  received_at: string;
+  snippet: string;
+  url: string;
+}
+
+interface EmailDetail {
+  account: string;
+  sender: string;
+  subject: string;
+  received_at: string;
+  url: string;
+  body: string;
+}
+
+interface AccountCount {
+  account: string;
+  count: number;
+}
+
+const PAGE = 50;
+
+function shortAccount(account: string): string {
+  return account.split('@')[0] || account || 'Unknown';
+}
+
+function senderName(sender: string): string {
+  const name = sender.replace(/<[^>]*>/, '').replace(/"/g, '').trim();
+  return name || sender;
+}
+
+function listDate(iso: string): string {
+  const d = new Date(iso);
+  if (Number.isNaN(d.getTime())) return '';
+  const now = new Date();
+  if (d.toDateString() === now.toDateString()) {
+    return d.toLocaleTimeString('en-AU', { hour: 'numeric', minute: '2-digit' });
+  }
+  return d.toLocaleDateString('en-AU', {
+    day: 'numeric', month: 'short', ...(d.getFullYear() !== now.getFullYear() && { year: 'numeric' }),
+  });
+}
+
+function received(iso: string): string {
+  const d = new Date(iso);
+  if (Number.isNaN(d.getTime())) return iso;
+  return d.toLocaleString('en-AU', {
+    weekday: 'short', day: 'numeric', month: 'short', year: 'numeric', hour: 'numeric', minute: '2-digit',
+  });
+}
+
+export function EmailsPage() {
+  const [emails, setEmails] = useState<EmailSummary[]>([]);
+  const [accounts, setAccounts] = useState<AccountCount[]>([]);
+  const [total, setTotal] = useState(0);
+  const [account, setAccount] = useState('');
+  const [query, setQuery] = useState('');
+  const [search, setSearch] = useState('');
+  const [loading, setLoading] = useState(true);
+  const [error, setError] = useState('');
+  const [selectedId, setSelectedId] = useState<string | null>(null);
+  const [detail, setDetail] = useState<EmailDetail | null>(null);
+
+  useEffect(() => {
+    const t = setTimeout(() => setSearch(query.trim()), 300);
+    return () => clearTimeout(t);
+  }, [query]);
+
+  const load = (offset: number) => {
+    setLoading(true);
+    const params = new URLSearchParams({ account, q: search, offset: String(offset), limit: String(PAGE) });
+    return apiFetch(`/api/personal/emails?${params}`)
+      .then((r) => {
+        if (!r.ok) throw new Error(`Server returned ${r.status}`);
+        return r.json();
+      })
+      .then((d) => {
+        setEmails((prev) => (offset ? [...prev, ...d.emails] : d.emails));
+        setAccounts(d.accounts);
+        setTotal(d.total);
+        setError('');
+        if (!offset) setSelectedId(d.emails[0]?.doc_id ?? null);
+      })
+      .catch((e) => setError(String(e.message ?? e)))
+      .finally(() => setLoading(false));
+  };
+
+  useEffect(() => {
+    load(0);
+  }, [account, search]);
+
+  useEffect(() => {
+    if (selectedId == null) {
+      setDetail(null);
+      return;
+    }
+    setDetail(null);
+    apiFetch(`/api/personal/emails/message?${new URLSearchParams({ id: selectedId })}`)
+      .then((r) => (r.ok ? r.json() : null))
+      .then(setDetail)
+      .catch(() => setDetail(null));
+  }, [selectedId]);
+
+  const allCount = accounts.reduce((n, a) => n + a.count, 0);
+  const tabs: [string, string, number][] = [
+    ['', 'All', allCount],
+    ...accounts.map((a): [string, string, number] => [a.account, shortAccount(a.account), a.count]),
+  ];
+
+  return (
+    <div className="flex-1 flex flex-col overflow-hidden px-6 py-6">
+      <div className="max-w-6xl mx-auto w-full flex flex-col flex-1 overflow-hidden gap-4">
+        <header className="flex flex-wrap items-center gap-3 shrink-0">
+          <div className="flex items-center gap-2 mr-2">
+            <Inbox size={20} style={{ color: 'var(--color-accent)' }} />
+            <h1 className="text-lg font-semibold" style={{ color: 'var(--color-text)' }}>
+              Emails
+            </h1>
+          </div>
+          <div
+            className="flex items-center gap-2 rounded-lg px-3 py-1.5 flex-1 min-w-[200px] max-w-sm"
+            style={{ background: 'var(--color-bg-secondary)', border: '1px solid var(--color-border)' }}
+          >
+            <Search size={14} style={{ color: 'var(--color-text-tertiary)' }} />
+            <input
+              value={query}
+              onChange={(e) => setQuery(e.target.value)}
+              placeholder="Search subject, sender or text…"
+              className="bg-transparent outline-none text-sm flex-1"
+              style={{ color: 'var(--color-text)' }}
+            />
+          </div>
+          <div className="flex flex-wrap gap-1">
+            {tabs.map(([value, label, count]) => (
+              <button
+                key={value || 'all'}
+                onClick={() => setAccount(value)}
+                title={value || 'All accounts'}
+                className="rounded-md px-2.5 py-1 text-xs cursor-pointer"
+                style={{
+                  background: account === value ? 'var(--color-accent)' : 'var(--color-bg-secondary)',
+                  color: account === value ? 'var(--color-on-accent)' : 'var(--color-text-secondary)',
+                  border: '1px solid var(--color-border)',
+                }}
+              >
+                {label} <span style={{ opacity: 0.7 }}>{count.toLocaleString()}</span>
+              </button>
+            ))}
+          </div>
+          <span className="text-xs ml-auto" style={{ color: 'var(--color-text-tertiary)' }}>
+            {total.toLocaleString()} emails
+          </span>
+        </header>
+
+        {error && (
+          <p className="text-sm" style={{ color: 'var(--color-error)' }}>
+            Could not load emails: {error}. Is <code>jarvis serve</code> running the latest version?
+          </p>
+        )}
+
+        <div className="flex flex-1 gap-4 overflow-hidden">
+          {/* List */}
+          <div className="w-[380px] shrink-0 overflow-y-auto flex flex-col gap-1.5 pr-1">
+            {!loading && !emails.length && !error && (
+              <p className="text-sm p-4" style={{ color: 'var(--color-text-tertiary)' }}>
+                {search ? 'No emails match that search.' : 'No emails stored yet. Add an account in Settings › Email accounts; inboxes sync every 15 minutes.'}
+              </p>
+            )}
+            {emails.map((e) => {
+              const active = e.doc_id === selectedId;
+              return (
+                <button
+                  key={e.doc_id}
+                  onClick={() => setSelectedId(e.doc_id)}
+                  className="text-left rounded-xl px-3 py-2.5 cursor-pointer transition-colors"
+                  style={{
+                    background: active ? 'var(--color-bg-tertiary)' : 'var(--color-bg-secondary)',
+                    border: `1px solid ${active ? 'var(--color-accent)' : 'var(--color-border)'}`,
+                  }}
+                >
+                  <div className="flex items-baseline justify-between gap-2">
+                    <span className="text-sm font-semibold truncate" style={{ color: 'var(--color-text)' }}>
+                      {senderName(e.sender)}
+                    </span>
+                    <span className="text-[11px] shrink-0" style={{ color: 'var(--color-text-tertiary)' }}>
+                      {listDate(e.received_at)}
+                    </span>
+                  </div>
+                  <div className="text-xs truncate" style={{ color: 'var(--color-text)' }}>
+                    {e.subject || '(no subject)'}
+                  </div>
+                  <div className="flex items-center justify-between gap-2 mt-0.5">
+                    <span className="text-xs truncate" style={{ color: 'var(--color-text-tertiary)' }}>
+                      {e.snippet}
+                    </span>
+                    {!account && (
+                      <span
+                        className="text-[10px] rounded px-1.5 shrink-0"
+                        style={{ background: 'var(--color-accent-subtle)', color: 'var(--color-accent)' }}
+                      >
+                        {shortAccount(e.account)}
+                      </span>
+                    )}
+                  </div>
+                </button>
+              );
+            })}
+            {loading && <Loader2 className="animate-spin m-4" size={18} />}
+            {!loading && emails.length < total && (
+              <button
+                onClick={() => load(emails.length)}
+                className="rounded-lg py-2 text-xs cursor-pointer"
+                style={{ background: 'var(--color-bg-secondary)', color: 'var(--color-text-secondary)', border: '1px solid var(--color-border)' }}
+              >
+                Load more ({(total - emails.length).toLocaleString()} left)
+              </button>
+            )}
+          </div>
+
+          {/* Detail */}
+          <div
+            className="flex-1 rounded-xl overflow-hidden flex flex-col"
+            style={{ background: 'var(--color-bg-secondary)', border: '1px solid var(--color-border)' }}
+          >
+            {!detail ? (
+              <div className="m-auto" style={{ color: 'var(--color-text-tertiary)' }}>
+                {selectedId == null ? 'Select an email' : <Loader2 className="animate-spin" size={18} />}
+              </div>
+            ) : (
+              <div className="flex-1 overflow-y-auto p-5 flex flex-col gap-4 text-sm"
+                   style={{ color: 'var(--color-text-secondary)' }}>
+                <div className="flex items-start justify-between gap-4">
+                  <h2 className="text-xl font-semibold break-words" style={{ color: 'var(--color-text)' }}>
+                    {detail.subject || '(no subject)'}
+                  </h2>
+                  {detail.url && (
+                    <a
+                      href={detail.url}
+                      target="_blank"
+                      rel="noreferrer"
+                      className="inline-flex items-center gap-1.5 rounded-md px-2.5 py-1 text-xs font-medium shrink-0"
+                      style={{ background: 'var(--color-accent)', color: 'var(--color-on-accent)' }}
+                    >
+                      <ExternalLink size={12} /> Open in Gmail
+                    </a>
+                  )}
+                </div>
+                <dl className="grid grid-cols-[auto_1fr] gap-x-3 gap-y-1 text-xs">
+                  <dt style={{ color: 'var(--color-text-tertiary)' }}>From</dt>
+                  <dd className="break-words" style={{ color: 'var(--color-text)' }}>{detail.sender}</dd>
+                  <dt style={{ color: 'var(--color-text-tertiary)' }}>Received</dt>
+                  <dd style={{ color: 'var(--color-text)' }}>{received(detail.received_at)}</dd>
+                  <dt style={{ color: 'var(--color-text-tertiary)' }}>Account</dt>
+                  <dd className="flex items-center gap-1" style={{ color: 'var(--color-text)' }}>
+                    <Mail size={11} /> {detail.account}
+                  </dd>
+                </dl>
+                <p className="whitespace-pre-wrap break-words leading-relaxed text-[13px] pt-3"
+                   style={{ borderTop: '1px solid var(--color-border-subtle)' }}>
+                  {detail.body || '(no text content)'}
+                </p>
+              </div>
+            )}
+          </div>
+        </div>
+      </div>
+    </div>
+  );
+}
diff --git a/frontend/src/pages/EventsPage.tsx b/frontend/src/pages/EventsPage.tsx
