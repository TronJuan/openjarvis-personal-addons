index 00000000..ce15124c
--- /dev/null
+++ b/src/openjarvis/personal/todo.py
@@ -0,0 +1,74 @@
+"""To-do list for the dashboard, read from the user's Markdown task notes.
+
+Lines use the Command Center format: ``- [ ] text 📅 YYYY-MM-DD ⏰ HH:MM``,
+optionally tagged ``#today``. Only open (unticked) lines are read; the files
+are never written.
+"""
+
+from __future__ import annotations
+
+import logging
+import re
+from datetime import date, timedelta
+from pathlib import Path
+from typing import Any, Iterable
+
+logger = logging.getLogger(__name__)
+
+URGENT_DAYS = 3  # due within this many days after today (or overdue)
+
+_OPEN = re.compile(r"^\s*[-*] \[ \] (.+)$")
+_DUE = re.compile(r"📅\s*(\d{4}-\d{2}-\d{2})")
+_TIME = re.compile(r"⏰\s*(\d{1,2}:\d{2})")
+_TODAY_TAG = re.compile(r"(?<!\S)#today\b")
+_WIKILINK = re.compile(r"\[\[([^\]|]+)(?:\|([^\]]+))?\]\]")
+_TASK_EMOJI = re.compile(r"[📅⏰⏳🛫✅➕🔁⏫🔼🔽🔺]\s*(?:\d{4}-\d{2}-\d{2}|\d{1,2}:\d{2})?")
+
+
+def parse_line(line: str) -> dict[str, Any] | None:
+    m = _OPEN.match(line)
+    if not m:
+        return None
+    raw = m.group(1)
+    due, at = _DUE.search(raw), _TIME.search(raw)
+    text = _WIKILINK.sub(lambda w: w.group(2) or w.group(1), raw)
+    text = _TODAY_TAG.sub("", _TASK_EMOJI.sub("", text))
+    text = " ".join(text.split()).rstrip(" —-")
+    if not text:
+        return None
+    return {"text": text, "due": due.group(1) if due else "",
+            "time": at.group(1) if at else "", "today": bool(_TODAY_TAG.search(raw))}
+
+
+def read_todos(paths: Iterable[str]) -> list[dict[str, Any]]:
+    items = []
+    for p in paths:
+        path = Path(p)
+        try:
+            lines = path.read_text(encoding="utf-8").splitlines()
+        except OSError as exc:
+            logger.warning("Could not read to-do file %s: %s", path, exc)
+            continue
+        for line in lines:
+            item = parse_line(line)
+            if item:
+                items.append(dict(item, source=path.stem))
+    return items
+
+
+def bucket(items: list[dict[str, Any]], today: date) -> dict[str, list[dict[str, Any]]]:
+    """Split into urgent (overdue or due soon), today and upcoming (later or undated)."""
+    iso = today.isoformat()
+    soon = (today + timedelta(days=URGENT_DAYS)).isoformat()
+    out: dict[str, list[dict[str, Any]]] = {"urgent": [], "today": [], "upcoming": []}
+    for item in items:
+        due = item["due"]
+        if due == iso or (item.get("today") and (not due or due > iso)):
+            out["today"].append(item)
+        elif due and due <= soon:
+            out["urgent"].append(item)
+        else:
+            out["upcoming"].append(item)
+    for key in out:
+        out[key].sort(key=lambda i: (not i["due"], i["due"], i["time"] or "99:99"))
+    return out
