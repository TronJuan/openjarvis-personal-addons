diff --git a/frontend/src/components/EmailAccountsEditor.tsx b/frontend/src/components/EmailAccountsEditor.tsx
new file mode 100644
index 00000000..457868c8
--- /dev/null
+++ b/frontend/src/components/EmailAccountsEditor.tsx
@@ -0,0 +1,130 @@
+import { useEffect, useState } from 'react';
+import { Mail, Plus, Trash2 } from 'lucide-react';
+import { toast } from 'sonner';
+import { apiFetch } from '../lib/api';
+
+interface EmailAccount {
+  email: string;
+  imap_host: string;
+}
+
+async function detail(r: Response, fallback: string): Promise<string> {
+  try {
+    const d = await r.json();
+    return typeof d.detail === 'string' ? d.detail : fallback;
+  } catch {
+    return fallback;
+  }
+}
+
+export function EmailAccountsEditor() {
+  const [accounts, setAccounts] = useState<EmailAccount[]>([]);
+  const [loaded, setLoaded] = useState(false);
+  const [adding, setAdding] = useState(false);
+  const [email, setEmail] = useState('');
+  const [password, setPassword] = useState('');
+  const [busy, setBusy] = useState(false);
+
+  useEffect(() => {
+    apiFetch('/api/personal/email-accounts')
+      .then((r) => r.json())
+      .then((d) => {
+        setAccounts(d.accounts);
+        setLoaded(true);
+      })
+      .catch(() => toast.error("Couldn't load email accounts"));
+  }, []);
+
+  const add = async () => {
+    setBusy(true);
+    try {
+      const r = await apiFetch('/api/personal/email-accounts', {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({ email: email.trim(), app_password: password }),
+      });
+      if (!r.ok) throw new Error(await detail(r, "Couldn't connect that account"));
+      setAccounts((await r.json()).accounts);
+      toast.success(`Connected ${email.trim()}. New mail is picked up on the next sync.`);
+      setEmail('');
+      setPassword('');
+      setAdding(false);
+    } catch (e) {
+      toast.error((e as Error).message);
+    } finally {
+      setBusy(false);
+    }
+  };
+
+  const remove = async (address: string) => {
+    const r = await apiFetch(`/api/personal/email-accounts?email=${encodeURIComponent(address)}`, { method: 'DELETE' });
+    if (!r.ok) {
+      toast.error(await detail(r, "Couldn't remove that account"));
+      return;
+    }
+    setAccounts((await r.json()).accounts);
+    toast.success(`Removed ${address}`);
+  };
+
+  const input = 'w-full rounded-md px-2 py-1.5 text-sm outline-none';
+  const inputStyle = {
+    background: 'var(--color-bg-secondary)',
+    border: '1px solid var(--color-border)',
+    color: 'var(--color-text)',
+  };
+
+  return (
+    <div className="flex flex-col gap-3">
+      <div className="text-xs" style={{ color: 'var(--color-text-tertiary)' }}>
+        Gmail accounts that Event Mate, inbox triage and the Emails page read from. Each one needs a Gmail app password:
+        turn on 2-Step Verification, then create one at{' '}
+        <a href="https://myaccount.google.com/apppasswords" target="_blank" rel="noopener noreferrer"
+          style={{ color: 'var(--color-accent)' }}>myaccount.google.com/apppasswords</a>.
+        Passwords are stored only on this computer.
+      </div>
+      {loaded && accounts.length === 0 && (
+        <div className="text-sm" style={{ color: 'var(--color-text-secondary)' }}>No email accounts connected yet.</div>
+      )}
+      {accounts.map((a) => (
+        <div key={a.email} className="flex items-center gap-3 rounded-lg px-3 py-2"
+          style={{ border: '1px solid var(--color-border-subtle)' }}>
+          <Mail size={15} style={{ color: 'var(--color-text-secondary)' }} />
+          <div className="flex-1 min-w-0 text-sm truncate" style={{ color: 'var(--color-text)' }}>{a.email}</div>
+          <button onClick={() => remove(a.email)} title={`Remove ${a.email}`} aria-label={`Remove ${a.email}`}
+            className="rounded-md p-2 cursor-pointer" style={{ color: 'var(--color-text-secondary)' }}>
+            <Trash2 size={15} />
+          </button>
+        </div>
+      ))}
+      {adding ? (
+        <div className="flex flex-col gap-2 rounded-lg p-3" style={{ border: '1px solid var(--color-border-subtle)' }}>
+          <input className={input} style={inputStyle} type="email" value={email} placeholder="you@gmail.com"
+            aria-label="Email address" autoComplete="off" onChange={(e) => setEmail(e.target.value)} />
+          <input className={input} style={inputStyle} type="password" value={password}
+            placeholder="16-character app password (spaces are fine)" aria-label="App password" autoComplete="new-password"
+            onChange={(e) => setPassword(e.target.value)}
+            onKeyDown={(e) => { if (e.key === 'Enter' && email && password && !busy) add(); }} />
+          <div className="flex gap-2">
+            <button onClick={add} disabled={!email.trim() || !password.trim() || busy}
+              className="rounded-md px-3 py-1.5 text-sm font-medium cursor-pointer disabled:opacity-40 disabled:cursor-default"
+              style={{ background: 'var(--color-accent)', color: '#0b0b0d' }}>
+              {busy ? 'Checking login...' : 'Connect'}
+            </button>
+            <button onClick={() => { setAdding(false); setEmail(''); setPassword(''); }}
+              className="rounded-md px-3 py-1.5 text-sm cursor-pointer" style={{ color: 'var(--color-text-secondary)' }}>
+              Cancel
+            </button>
+          </div>
+        </div>
+      ) : (
+        <div>
+          <button onClick={() => setAdding(true)}
+            className="flex items-center gap-1.5 rounded-md px-3 py-1.5 text-sm cursor-pointer"
+            style={{ border: '1px solid var(--color-border)', color: 'var(--color-text)' }}>
+            <Plus size={14} /> Add email account
+          </button>
+        </div>
+      )}
+    </div>
+  );
+}
