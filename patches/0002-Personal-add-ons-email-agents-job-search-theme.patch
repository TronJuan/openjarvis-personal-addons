diff --git a/frontend/src/components/ThemeRows.tsx b/frontend/src/components/ThemeRows.tsx
new file mode 100644
index 00000000..30d2c386
--- /dev/null
+++ b/frontend/src/components/ThemeRows.tsx
@@ -0,0 +1,100 @@
+import { useState } from 'react';
+import { useAppStore } from '../lib/store';
+import { apiFetch } from '../lib/api';
+
+const ACCENT_PRESETS = [
+  { label: 'Teal', value: '#39c5bb' },
+  { label: 'Cyan', value: '#0891b2' },
+  { label: 'Blue', value: '#2563eb' },
+  { label: 'Violet', value: '#8b5cf6' },
+  { label: 'Pink', value: '#ec4899' },
+  { label: 'Amber', value: '#f59e0b' },
+  { label: 'Green', value: '#16a34a' },
+];
+
+function Row({ label, description, children }: { label: string; description?: string; children: React.ReactNode }) {
+  return (
+    <div className="flex items-center justify-between py-3" style={{ borderBottom: '1px solid var(--color-border-subtle)' }}>
+      <div className="min-w-0">
+        <div className="text-sm" style={{ color: 'var(--color-text)' }}>{label}</div>
+        {description && (
+          <div className="text-xs mt-0.5 break-words" style={{ color: 'var(--color-text-tertiary)' }}>{description}</div>
+        )}
+      </div>
+      <div>{children}</div>
+    </div>
+  );
+}
+
+export function ThemeRows({ onSaved }: { onSaved: () => void }) {
+  const settings = useAppStore((s) => s.settings);
+  const updateSettings = useAppStore((s) => s.updateSettings);
+  const [bgError, setBgError] = useState('');
+  const control = { background: 'var(--color-bg-secondary)', color: 'var(--color-text)', border: '1px solid var(--color-border)' };
+
+  const setAccent = (accentColor: string) => { updateSettings({ accentColor }); onSaved(); };
+
+  const uploadBackground = async (file: File | undefined) => {
+    if (!file) return;
+    setBgError('');
+    const r = await apiFetch('/api/personal/theme/background', {
+      method: 'PUT', headers: { 'Content-Type': file.type }, body: file,
+    });
+    if (!r.ok) {
+      setBgError((await r.json().catch(() => null))?.detail ?? `Upload failed (${r.status})`);
+      return;
+    }
+    updateSettings({ backgroundVersion: Date.now() });
+    onSaved();
+  };
+
+  const removeBackground = async () => {
+    await apiFetch('/api/personal/theme/background', { method: 'DELETE' });
+    updateSettings({ backgroundVersion: 0 });
+    onSaved();
+  };
+
+  return (
+    <>
+      <Row label="Accent colour" description="Buttons, links and highlights">
+        <div className="flex items-center gap-1.5">
+          {ACCENT_PRESETS.map((p) => (
+            <button key={p.value} title={p.label} aria-label={p.label} onClick={() => setAccent(p.value)}
+                    className="w-6 h-6 rounded-full cursor-pointer"
+                    style={{ background: p.value, outline: settings.accentColor === p.value ? '2px solid var(--color-text)' : 'none', outlineOffset: 2 }} />
+          ))}
+          <input type="color" title="Custom colour" aria-label="Custom accent colour"
+                 value={settings.accentColor || '#0891b2'} onChange={(e) => setAccent(e.target.value)}
+                 className="w-7 h-7 rounded cursor-pointer" style={{ background: 'transparent', border: 'none' }} />
+          {settings.accentColor && (
+            <button onClick={() => setAccent('')} className="text-xs px-2 py-1 rounded-md cursor-pointer" style={control}>
+              Reset
+            </button>
+          )}
+        </div>
+      </Row>
+      <Row label="Background image" description={bgError || 'Shown behind every page; stored on this computer'}>
+        <div className="flex items-center gap-2">
+          <label className="text-xs px-3 py-1.5 rounded-lg cursor-pointer" style={control}>
+            {settings.backgroundVersion ? 'Change image' : 'Choose image'}
+            <input type="file" accept="image/png,image/jpeg,image/webp,image/gif" className="hidden"
+                   onChange={(e) => { uploadBackground(e.target.files?.[0]); e.target.value = ''; }} />
+          </label>
+          {settings.backgroundVersion > 0 && (
+            <button onClick={removeBackground} className="text-xs px-3 py-1.5 rounded-lg cursor-pointer" style={control}>
+              Remove
+            </button>
+          )}
+        </div>
+      </Row>
+      {settings.backgroundVersion > 0 && (
+        <Row label="Background fade" description="Higher keeps text easier to read">
+          <input type="range" min={0} max={90} step={5} value={settings.backgroundDim}
+                 onChange={(e) => updateSettings({ backgroundDim: Number(e.target.value) })}
+                 onMouseUp={onSaved} aria-label="Background fade"
+                 style={{ accentColor: 'var(--color-accent)' }} />
+        </Row>
+      )}
+    </>
+  );
+}
