+"""Personal agents: Event Mate, inbox triage, and the daily job search.
+
+These are deterministic pipelines with targeted local-model calls rather than
+free-form tool loops, so a 9B model can run them reliably. Results land in
+``personal.db`` under the OpenJarvis home and are served to the dashboard by
+``openjarvis.server.personal_routes``.
+"""
diff --git a/src/openjarvis/personal/apply.py b/src/openjarvis/personal/apply.py
new file mode 100644
index 00000000..d8dad7b8
--- /dev/null
+++ b/src/openjarvis/personal/apply.py
@@ -0,0 +1,211 @@
+"""Open a job application in a visible browser and fill in what it can.
+
+It never submits: it fills recognisable fields (name, email, phone,
+LinkedIn, cover letter, resume upload) and leaves the window open for the user
+to check everything and press Submit. Chrome 136+ refuses automation of the
+real ``User Data`` folder, so it uses its own profile in
+``personal/browser-profile``; sign in to job sites there once and the logins
+persist. The profile folder name inside it is the
+``browser_profile_directory`` setting.
+
+Run with ``python -m openjarvis.personal.apply <job_id>``.
+"""
+
+from __future__ import annotations
+
+import logging
+import re
+import sys
+import time
+from pathlib import Path
+
+from openjarvis.personal.store import PersonalStore, load_settings, personal_dir
+
+logger = logging.getLogger("openjarvis.personal.apply")
+
+WATCH_MINUTES = 45
+_APPLY_TEXT = re.compile(r"^\s*(quick apply|easy apply|apply( now| for this job| on company site)?)\s*$", re.I)
+
+
+def contact_details(resume_md: str, profile: dict[str, str] | None = None) -> dict[str, str]:
+    """Contact details from the Settings profile, falling back to the resume text."""
+    profile = profile or {}
+    name = re.search(r"^##\s+(.+)$", resume_md, re.M)
+    full = profile.get("name", "").strip() or (name.group(1).strip() if name else "")
+    first, _, last = full.partition(" ")
+    email = re.search(r"[\w.+-]+@[\w-]+\.[\w.]+", resume_md)
+    phone = re.search(r"\+?\d[\d ]{7,}\d", resume_md)
+    linkedin = profile.get("linkedin", "").strip() or (lambda m: m.group(0) if m else "")(
+        re.search(r"(?:https?://)?(?:www\.)?linkedin\.com/in/[\w-]+", resume_md))
+    return {"full_name": full, "first_name": first, "last_name": last,
+            "email": profile.get("email", "").strip() or (email.group(0) if email else ""),
+            "phone": profile.get("phone", "").strip() or (phone.group(0) if phone else ""),
+            "linkedin": ("https://" + linkedin.split("://")[-1]) if linkedin else ""}
+
+
+def write_docx(markdown: str, path: Path) -> Path:
+    """Simple Word version of a markdown draft (headings, bullets, paragraphs)."""
+    from docx import Document
+
+    doc = Document()
+    for raw in markdown.splitlines():
+        line = raw.strip()
+        if not line or line.startswith(">"):
+            continue
+        heading = re.match(r"^(#{1,4})\s+(.*)", line)
+        text = re.sub(r"\*\*(.+?)\*\*|\[\[(?:[^\]|]+\|)?([^\]]+)\]\]",
+                      lambda m: m.group(1) or m.group(2), line)
+        if heading:
+            doc.add_heading(re.sub(r"^#+\s+", "", text), level=min(len(heading.group(1)) - 1, 3) or 1)
+        elif re.match(r"^[-*]\s+", text):
+            doc.add_paragraph(re.sub(r"^[-*]\s+", "", text), style="List Bullet")
+        else:
+            doc.add_paragraph(text)
+    doc.save(path)
+    return path
+
+
+def prepare(job_id: int) -> dict:
+    """Make sure drafts exist and export them as Word files; returns what to fill."""
+    from openjarvis.personal.jobs import draft_job, read_drafts
+
+    with PersonalStore() as store:
+        job = store.get_job(job_id)
+    if job is None:
+        raise KeyError(job_id)
+    if not job["resume_draft"]:
+        draft_job(job_id)
+        with PersonalStore() as store:
+            job = store.get_job(job_id)
+    drafts = read_drafts(job["resume_draft"])
+    out = personal_dir() / "applications" / Path(job["resume_draft"]).stem
+    out.mkdir(parents=True, exist_ok=True)
+    details = contact_details(drafts["resume"], load_settings()["profile"])
+    base = re.sub(r"\W+", " ", details["full_name"] or "Resume").strip().replace(" ", "_")
+    resume_file = write_docx(drafts["resume"], out / f"{base}_Resume.docx")
+    letter = drafts["cover_letter"]
+    if letter.startswith("Not drafted"):
+        letter = ""
+    letter = re.sub(r"(?s)^> \[!danger\].*?\n\n", "", letter)
+    letter_file = write_docx(letter, out / f"{base}_Cover_Letter.docx") if letter else None
+    return {"url": job["url"], "details": details, "cover_letter": letter,
+            "resume_file": str(resume_file),
+            "letter_file": str(letter_file) if letter_file else ""}
+
+
+def _label(field) -> str:
+    """Everything that describes an input: its attributes plus its <label> text."""
+    return field.evaluate("""el => {
+        const bits = [el.name, el.id, el.placeholder, el.getAttribute('aria-label'),
+                      el.getAttribute('autocomplete'), el.getAttribute('data-automation')];
+        if (el.id) { const l = document.querySelector(`label[for="${CSS.escape(el.id)}"]`); if (l) bits.push(l.innerText); }
+        const wrap = el.closest('label'); if (wrap) bits.push(wrap.innerText);
+        return bits.filter(Boolean).join(' ').toLowerCase();
+    }""")
+
+
+def _value_for(label: str, d: dict[str, str], letter: str) -> str:
+    if "linkedin" in label:
+        return d["linkedin"]
+    if "email" in label:
+        return d["email"]
+    if re.search(r"phone|mobile|\btel\b", label):
+        return d["phone"]
+    if re.search(r"first.?name|given.?name|fname", label):
+        return d["first_name"]
+    if re.search(r"last.?name|family.?name|surname|lname", label):
+        return d["last_name"]
+    if re.search(r"full.?name|^name\b|\bname\b", label) and "user" not in label and "company" not in label:
+        return d["full_name"]
+    if re.search(r"cover.?letter|covering|message to|why .*(interested|apply)", label):
+        return letter
+    return ""
+
+
+def fill_page(page, info: dict) -> int:
+    """Fill empty recognised fields on every frame of the page; returns how many."""
+    filled = 0
+    for frame in page.frames:
+        try:
+            fields = frame.query_selector_all(
+                "input:not([type=hidden]):not([type=submit]):not([type=button]), textarea")
+        except Exception:
+            continue
+        for field in fields:
+            try:
+                if not field.is_visible() or field.is_disabled():
+                    continue
+                kind = (field.get_attribute("type") or "text").lower()
+                label = _label(field)
+                if kind == "file":
+                    if field.evaluate("el => el.files.length") > 0:
+                        continue
+                    if "cover" in label and info["letter_file"]:
+                        field.set_input_files(info["letter_file"])
+                    elif re.search(r"resume|\bcv\b|curriculum", label) or "cover" not in label:
+                        field.set_input_files(info["resume_file"])
+                    filled += 1
+                    continue
+                if kind in ("checkbox", "radio", "password", "search") or field.input_value():
+                    continue
+                value = _value_for(label, info["details"], info["cover_letter"])
+                if value:
+                    field.fill(value)
+                    filled += 1
+            except Exception:
+                continue
+    return filled
+
+
+def _click_apply(page) -> None:
+    for role in ("link", "button"):
+        for el in page.get_by_role(role).all():
+            try:
+                if _APPLY_TEXT.match(el.inner_text(timeout=500) or "") and el.is_visible():
+                    el.click()
+                    page.wait_for_load_state("domcontentloaded")
+                    return
+            except Exception:
+                continue
+
+
+def run(job_id: int) -> None:
+    from playwright.sync_api import sync_playwright
+
+    info = prepare(job_id)
+    logger.info("Opening %s", info["url"])
+    with sync_playwright() as p:
+        ctx = p.chromium.launch_persistent_context(
+            str(personal_dir() / "browser-profile"), channel="chrome", headless=False,
+            no_viewport=True,
+            args=["--start-maximized",
+                  f"--profile-directory={load_settings()['browser_profile_directory']}"])
+        page = ctx.pages[0] if ctx.pages else ctx.new_page()
+        page.goto(info["url"], wait_until="domcontentloaded")
+        _click_apply(page)
+        # Multi-step forms: keep filling new pages until the user closes the browser.
+        deadline = time.time() + WATCH_MINUTES * 60
+        while time.time() < deadline and ctx.pages:
+            for pg in list(ctx.pages):
+                n = fill_page(pg, info)
+                if n:
+                    logger.info("Filled %d field(s) on %s", n, pg.url)
+            time.sleep(2)
+        try:
+            ctx.close()
+        except Exception:
+            pass
+
+
+def main() -> None:
+    logging.basicConfig(filename=str(personal_dir() / "apply.log"), level=logging.INFO,
+                        format="%(asctime)s %(levelname)s %(message)s")
+    try:
+        run(int(sys.argv[1]))
+    except Exception:
+        logger.exception("Application helper failed")
+        raise
+
+
+if __name__ == "__main__":
+    main()
diff --git a/src/openjarvis/personal/eventmate.py b/src/openjarvis/personal/eventmate.py
new file mode 100644
index 00000000..03159a64
--- /dev/null
+++ b/src/openjarvis/personal/eventmate.py
@@ -0,0 +1,446 @@
+"""Event Mate and inbox triage, run over newly synced Gmail messages.
+
+Order follows the original Event Mate: cheap deterministic steps first
+(dedup, whitelist), model calls last and on the fewest items. Every new
+email gets one short triage call (important? deadline?). Only emails that
+pass the editable whitelist get the event extraction call, and scoring only
+runs on events that have no score yet.
+"""
+
+from __future__ import annotations
+
+import json
+import logging
+import re
+import sqlite3
+import time
+from dataclasses import dataclass
+from datetime import datetime, timedelta, timezone
+from email.utils import parseaddr
+from typing import Any
+from urllib.parse import quote
+
+from openjarvis.core.paths import get_config_dir
+from openjarvis.personal import llm
+from openjarvis.personal.store import (
+    PersonalStore,
+    load_preferences,
+    load_whitelist,
+    now_local,
+)
+
+logger = logging.getLogger(__name__)
+
+AGENT = "eventmate"
+_DATE_RE = re.compile(r"^\d{4}-\d{2}-\d{2}$")
+_EVENT_CATEGORIES = {"Career", "Networking", "Social", "Academic", "Sport"}
+
+
+@dataclass
+class Email:
+    doc_id: str
+    account: str
+    sender: str
+    subject: str
+    received_at: str  # UTC ISO
+    url: str
+    body: str
+
+
+def sync_gmail(since_days: int | None, backfill: frozenset[str] = frozenset()) -> int:
+    """Fetch recent messages for every connected Gmail account into the store.
+
+    Accounts in ``backfill`` ignore their stored-UID floor, so older inbox mail
+    is fetched too (already stored messages are de-duplicated by the pipeline).
+    """
+    import openjarvis.connectors  # noqa: F401  (registers connectors)
+    from openjarvis.connectors.gmail_imap import GmailIMAPConnector
+    from openjarvis.connectors.pipeline import IngestionPipeline
+    from openjarvis.connectors.store import KnowledgeStore
+    from openjarvis.connectors.sync_engine import SyncEngine
+
+    floors = {a: f for a, f in _stored_uid_floors().items() if a not in backfill}
+    connector = GmailIMAPConnector(since_days=since_days, uid_floors=floors)
+    if not connector.is_connected():
+        logger.warning("gmail_imap is not connected; skipping sync")
+        return 0
+    with KnowledgeStore() as store:
+        with SyncEngine(pipeline=IngestionPipeline(store=store)) as engine:
+            return engine.sync(connector)
+
+
+def _stored_uid_floors() -> dict[str, tuple[str, int]]:
+    """Highest IMAP UID already stored per account, so polls fetch only new mail."""
+    if not (get_config_dir() / "knowledge.db").exists():
+        return {}
+    conn = sqlite3.connect(f"file:{get_config_dir() / 'knowledge.db'}?mode=ro",
+                           uri=True, timeout=30)
+    try:
+        rows = conn.execute(
+            "SELECT json_extract(metadata, '$.account'),"
+            " json_extract(metadata, '$.imap_uidvalidity'),"
+            " MAX(CAST(json_extract(metadata, '$.imap_uid') AS INTEGER))"
+            " FROM knowledge_chunks WHERE source = 'gmail' AND chunk_index = 0"
+            " GROUP BY 1, 2"
+        ).fetchall()
+    finally:
+        conn.close()
+    return {acct.lower(): (str(validity), int(uid))
+            for acct, validity, uid in rows if acct and uid is not None}
+
+
+def load_recent_emails(lookback_days: int, skip: set[str]) -> list[Email]:
+    cutoff = datetime.now(timezone.utc) - timedelta(days=lookback_days)
+    if not (get_config_dir() / "knowledge.db").exists():
+        return []  # nothing has been synced yet
+    conn = sqlite3.connect(f"file:{get_config_dir() / 'knowledge.db'}?mode=ro",
+                           uri=True, timeout=30)
+    try:
+        rows = conn.execute(
+            "SELECT doc_id, title, author, timestamp, url, metadata, content"
+            " FROM knowledge_chunks WHERE source = 'gmail' AND doc_type = 'email'"
+            " AND deleted_at IS NULL ORDER BY doc_id, chunk_index"
+        ).fetchall()
+    finally:
+        conn.close()
+
+    emails: dict[str, Email] = {}
+    for doc_id, title, author, ts, url, meta, content in rows:
+        if doc_id in skip:
+            continue
+        if doc_id in emails:
+            emails[doc_id].body += "\n" + (content or "")
+            continue
+        try:
+            received = datetime.fromisoformat(ts)
+        except (TypeError, ValueError):
+            continue
+        if received.tzinfo is None:
+            received = received.replace(tzinfo=timezone.utc)
+        if received < cutoff:
+            continue
+        try:
+            meta = json.loads(meta or "{}")
+        except json.JSONDecodeError:
+            meta = {}
+        account = meta.get("account", "")
+        emails[doc_id] = Email(
+            doc_id=doc_id,
+            account=account,
+            sender=author or "",
+            subject=title or "",
+            received_at=received.astimezone(timezone.utc).isoformat(),
+            url=gmail_link(account, meta.get("message_id", ""), url or ""),
+            body=content or "",
+        )
+    for email in emails.values():
+        email.body = _plain_text(email.body)
+    return sorted(emails.values(), key=lambda e: e.received_at)
+
+
+def load_email(doc_id: str) -> Email | None:
+    """One stored Gmail message as plain text, or None if it is not stored."""
+    try:
+        conn = sqlite3.connect(
+            f"file:{get_config_dir() / 'knowledge.db'}?mode=ro", uri=True, timeout=30)
+    except sqlite3.OperationalError:
+        return None
+    try:
+        rows = conn.execute(
+            "SELECT title, author, timestamp, url, metadata, content"
+            " FROM knowledge_chunks WHERE source = 'gmail' AND doc_id = ?"
+            " AND deleted_at IS NULL ORDER BY chunk_index", (doc_id,)
+        ).fetchall()
+    finally:
+        conn.close()
+    if not rows:
+        return None
+    title, author, ts, url, meta, _ = rows[0]
+    try:
+        received = datetime.fromisoformat(ts)
+        if received.tzinfo is None:
+            received = received.replace(tzinfo=timezone.utc)
+        received_at = received.astimezone(timezone.utc).isoformat()
+    except (TypeError, ValueError):
+        received_at = ts or ""
+    try:
+        meta = json.loads(meta or "{}")
+    except json.JSONDecodeError:
+        meta = {}
+    account = meta.get("account", "")
+    return Email(
+        doc_id=doc_id,
+        account=account,
+        sender=author or "",
+        subject=title or "",
+        received_at=received_at,
+        url=gmail_link(account, meta.get("message_id", ""), url or ""),
+        body=_plain_text(_join_chunks([r[5] or "" for r in rows])),
+    )
+
+
+def _join_chunks(chunks: list[str]) -> str:
+    """Rejoin stored chunks, dropping the tail of the previous chunk that the
+    chunker prepends to each one (single-space joined, so compare that way)."""
+    text = chunks[0] if chunks else ""
+    for prev, chunk in zip(chunks, chunks[1:]):
+        prev_norm = " ".join(prev.split())
+        cut = next((j for j in range(min(len(chunk) - 1, len(prev_norm)), 0, -1)
+                    if chunk[j] == " " and prev_norm.endswith(chunk[:j])), 0)
+        text += "\n" + chunk[cut:].lstrip()
+    return text
+
+
+def gmail_link(account: str, message_id: str, fallback: str = "") -> str:
+    """Gmail web link that opens this exact message in the right account."""
+    if not message_id:
+        return fallback
+    search = quote(f"rfc822msgid:{message_id.strip('<>')}", safe="")
+    return f"https://mail.google.com/mail/?authuser={quote(account, safe='@')}#search/{search}"
+
+
+def _plain_text(body: str) -> str:
+    """Strip HTML the connector stored verbatim, keeping line breaks readable."""
+    import html as html_lib
+
+    if "<" in body:
+        body = re.sub(r"<(script|style)[^>]*>.*?</\1>", " ", body, flags=re.S | re.I)
+        body = re.sub(r"(?i)<br\s*/?>|</(p|div|h\d|li|tr)>", "\n", body)
+        body = re.sub(r"<[^>]+>", " ", body)
+    body = html_lib.unescape(body)
+    lines = (" ".join(line.split()) for line in body.splitlines())
+    return re.sub(r"\n{3,}", "\n\n", "\n".join(lines)).strip()
+
+
+def matches_whitelist(email: Email, whitelist: dict[str, list[str]]) -> bool:
+    domain = parseaddr(email.sender)[1].rpartition("@")[2].lower()
+    for allowed in whitelist["sender_domains"]:
+        if domain == allowed or domain.endswith("." + allowed):
+            return True
+    text = f"{email.subject}\n{email.body[:3000]}".lower()
+    return any(
+        re.search(rf"(?<![a-z0-9]){re.escape(k)}(?![a-z0-9])", text)
+        for k in whitelist["keywords"]
+    )
+
+
+def _email_block(email: Email, max_chars: int) -> str:
+    return (
+        f"From: {email.sender}\nTo account: {email.account}\n"
+        f"Received: {email.received_at}\nSubject: {email.subject}\n\n"
+        f"{email.body[:max_chars]}"
+    )
+
+
+def _clean_date(value: Any) -> str:
+    value = str(value or "").strip()
+    return value if _DATE_RE.match(value) else ""
+
+
+# -- triage -------------------------------------------------------------------
+
+_TRIAGE_SYSTEM = """You triage a person's email inbox. Today is {today}.
+
+Decide whether this email is IMPORTANT: it needs the user's attention or action. Important examples: university admin, assessments or enrolment, replies about job or internship applications, interviews, bills or payments due, security alerts that report a problem or suspicious activity, and personal messages from real people. NOT important: marketing, promotions, newsletters, shopping, social media notifications, generic mailing lists, automated job alerts and job-board digests ("X is hiring", "top jobs for you"; a separate job agent covers those), and routine automated account notices (new sign-in, app password created, 2-Step Verification turned on, product or policy updates) unless they say something is wrong or ask the user to act by a date.
+
+Also find a DEADLINE if the email states one the user must meet (a due date, application close, RSVP by, payment due). Only use a date written in the email; resolve relative dates like "this Friday" against the received date. Never guess.
+
+{untrusted}
+
+Reply with only a JSON object:
+{{"important": true|false, "why": "<one short sentence>", "deadline": "YYYY-MM-DD" or null, "deadline_what": "<what is due, a few words>"}}"""
+
+
+def triage(email: Email) -> dict[str, Any]:
+    system = _TRIAGE_SYSTEM.format(
+        today=now_local().date().isoformat(), untrusted=llm.UNTRUSTED_NOTE
+    )
+    return llm.chat_json(system, _email_block(email, 2500), temperature=0)
+
+
+# -- events -------------------------------------------------------------------
+
+_EXTRACT_SYSTEM = """You are Event Mate, an event assistant. Today is {today}.
+
+Classify the email as exactly one of:
+- "event_promotion": announces one or more events, workshops, socials, competitions, career fairs, club events, or similar.
+- "registration_confirmation": confirms the user has signed up for an event.
+- "not_relevant": newsletters, admin notices, or emails without a specific actionable event.
+
+For event_promotion, extract one entry per distinct event. For registration_confirmation, extract the confirmed event. Rules:
+- name is required: the event's title, or a short descriptive title if none is given.
+- Never invent information. Leave other fields as "" when the email does not state them.
+- date must be YYYY-MM-DD or "". Resolve relative dates against the received date. Times as HH:MM 24-hour or "".
+- category is one of Career, Networking, Social, Academic, Sport.
+- description: 1-2 sentences in your own words.
+- rsvp_by: the registration deadline as YYYY-MM-DD, or "".
+- cancelled: true only if the email says the event is cancelled.
+
+{untrusted}
+
+Reply with only a JSON object:
+{{"category": "event_promotion"|"registration_confirmation"|"not_relevant", "events": [{{"name": "", "organisation": "", "date": "", "start_time": "", "end_time": "", "location": "", "category": "", "description": "", "registration_link": "", "cost": "", "rsvp_by": "", "cancelled": false}}]}}"""
+
+
+def extract_events(email: Email) -> dict[str, Any]:
+    system = _EXTRACT_SYSTEM.format(
+        today=now_local().date().isoformat(), untrusted=llm.UNTRUSTED_NOTE
+    )
+    return llm.chat_json(system, _email_block(email, 6000), temperature=0)
+
+
+_SCORE_SYSTEM = """Score how well an event fits the user's preferences, from 0 to 100, using judgment against this rubric:
+- Category matches a listed interest: up to 40 points
+- Organisation or topic matches a career interest: up to 25 points
+- Timing matches stated preferences: up to 15 points
+- Location matches stated preferences: up to 10 points
+- Free or low-cost: up to 10 points
+
+User preferences:
+{preferences}
+
+Reply with only a JSON object: {{"score": <integer 0-100>, "why": "<one sentence tying the event to the preferences>"}}"""
+
+
+def score_event(row: sqlite3.Row, preferences: str) -> tuple[int, str]:
+    event = {k: row[k] for k in ("name", "organisation", "date", "start_time",
+                                 "end_time", "location", "category",
+                                 "description", "cost")}
+    data = llm.chat_json(_SCORE_SYSTEM.format(preferences=preferences),
+                         json.dumps(event, ensure_ascii=False), temperature=0)
+    score = max(0, min(100, int(data.get("score", 0))))
+    return score, str(data.get("why", ""))[:300]
+
+
+def _band(score: int) -> str:
+    return "High" if score >= 80 else "Medium" if score >= 50 else "Low"
+
+
+# -- run ----------------------------------------------------------------------
+
+
+def _handle_events(store: PersonalStore, email: Email, data: dict) -> tuple[str, int]:
+    category = str(data.get("category", "not_relevant"))
+    if category not in ("event_promotion", "registration_confirmation"):
+        return "not_relevant", 0
+    count = 0
+    for ev in data.get("events") or []:
+        name = str(ev.get("name", "")).strip() or email.subject.strip()
+        if not name:
+            continue
+        fields = {
+            "name": name[:200],
+            "organisation": str(ev.get("organisation", ""))[:200],
+            "date": _clean_date(ev.get("date")),
+            "start_time": str(ev.get("start_time", ""))[:5],
+            "end_time": str(ev.get("end_time", ""))[:5],
+            "location": str(ev.get("location", ""))[:200],
+            "category": ev.get("category") if ev.get("category") in _EVENT_CATEGORIES else "",
+            "description": str(ev.get("description", ""))[:500],
+            "registration_link": str(ev.get("registration_link", ""))[:500],
+            "cost": str(ev.get("cost", ""))[:100],
+            "source_doc_id": email.doc_id,
+            "account": email.account,
+        }
+        if category == "registration_confirmation":
+            match = store.find_event_by_name(name)
+            event_id = match["id"] if match else store.upsert_event(fields)
+            store.update_event(event_id, status="Enrolled")
+        else:
+            event_id = store.upsert_event(fields)
+        if ev.get("cancelled"):
+            store.update_event(event_id, status="Rejected",
+                               why="Cancelled according to the source email.")
+        rsvp = _clean_date(ev.get("rsvp_by"))
+        if rsvp and category == "event_promotion" and not ev.get("cancelled"):
+            store.add_deadline(rsvp, f"RSVP: {name}", "event", email.doc_id,
+                               email.account)
+        count += 1
+    return category, count
+
+
+def run(*, sync: bool = True, sync_days: int = 2, lookback_days: int = 3,
+        limit: int | None = None) -> dict[str, Any]:
+    """Process new email. Returns counts for the CLI and run log."""
+    stats = {"synced": 0, "new_emails": 0, "whitelisted": 0, "important": 0,
+             "events": 0, "scored": 0, "errors": 0}
+    with PersonalStore() as store:
+        store.run_started(AGENT)
+        try:
+            if sync:
+                try:
+                    stats["synced"] = sync_gmail(sync_days)
+                except Exception as exc:  # keep processing what is already stored
+                    logger.error("Gmail sync failed: %s", exc)
+                    stats["errors"] += 1
+
+            whitelist = load_whitelist()
+            emails = load_recent_emails(lookback_days, store.seen_doc_ids())
+            if limit:
+                emails = emails[-limit:]
+            stats["new_emails"] = len(emails)
+
+            for email in emails:
+                important, category, whitelisted = False, "", False
+                try:
+                    t = triage(email)
+                    important = bool(t.get("important"))
+                    if important:
+                        store.add_important_email(
+                            doc_id=email.doc_id, account=email.account,
+                            sender=email.sender, subject=email.subject,
+                            received_at=email.received_at,
+                            why=str(t.get("why", ""))[:300], url=email.url,
+                        )
+                        stats["important"] += 1
+                    deadline = _clean_date(t.get("deadline"))
+                    if deadline:
+                        what = str(t.get("deadline_what") or email.subject)[:200]
+                        store.add_deadline(deadline, what, "email", email.doc_id,
+                                           email.account)
+
+                    whitelisted = matches_whitelist(email, whitelist)
+                    if whitelisted:
+                        stats["whitelisted"] += 1
+                        category, n = _handle_events(store, email,
+                                                     extract_events(email))
+                        stats["events"] += n
+                except Exception as exc:
+                    # Left unmarked so the next run retries this email.
+                    logger.error("Failed on %s: %s", email.subject[:60], exc)
+                    stats["errors"] += 1
+                    continue
+                store.mark_seen(email.doc_id, email.account, email.received_at,
+                                whitelisted=whitelisted, important=important,
+                                category=category)
+
+            preferences = load_preferences()
+            today = now_local().date().isoformat()
+            for row in store.unscored_events():
+                if row["date"] and row["date"] < today:
+                    continue
+                try:
+                    score, why = score_event(row, preferences)
+                except Exception as exc:
+                    logger.error("Scoring failed for %s: %s", row["name"], exc)
+                    stats["errors"] += 1
+                    continue
+                status = row["status"] if row["status"] != "New" else "Recommended"
+                store.update_event(row["id"], score=score, why=why,
+                                   recommendation=_band(score), status=status)
+                stats["scored"] += 1
+        except Exception as exc:
+            store.run_finished(AGENT, "error", str(exc))
+            raise
+        store.run_finished(AGENT, "ok" if not stats["errors"] else "partial",
+                           json.dumps(stats))
+    return stats
+
+
+def is_running(max_age_seconds: float = 1800) -> bool:
+    with PersonalStore() as store:
+        row = store._conn.execute(
+            "SELECT last_status, last_started FROM runs WHERE agent = ?", (AGENT,)
+        ).fetchone()
+    return bool(row and row[0] == "running" and row[1]
+                and time.time() - row[1] < max_age_seconds)
diff --git a/src/openjarvis/personal/inbox.py b/src/openjarvis/personal/inbox.py
new file mode 100644
index 00000000..1ab43149
--- /dev/null
+++ b/src/openjarvis/personal/inbox.py
@@ -0,0 +1,108 @@
+"""Every stored inbox email from all connected Gmail accounts, for the Emails page.
+
+The Gmail sync only reads each account's INBOX, so spam and trash are never
+stored. The list is cached in memory and reloaded when new mail is stored.
+"""
+
+from __future__ import annotations
+
+import json
+import re
+import sqlite3
+import threading
+from datetime import datetime, timezone
+from typing import Any
+
+from openjarvis.core.config import get_config_dir
+from openjarvis.personal.eventmate import _plain_text, gmail_link
+
+_lock = threading.Lock()
+_cache: dict[str, Any] = {"key": None, "emails": []}
+
+
+def _connect() -> sqlite3.Connection:
+    return sqlite3.connect(f"file:{get_config_dir() / 'knowledge.db'}?mode=ro",
+                           uri=True, timeout=30)
+
+
+def _utc(ts: str) -> str:
+    try:
+        when = datetime.fromisoformat(ts)
+    except (TypeError, ValueError):
+        return ts or ""
+    if when.tzinfo is None:
+        when = when.replace(tzinfo=timezone.utc)
+    return when.astimezone(timezone.utc).isoformat()
+
+
+def _snippet(content: str) -> str:
+    # The first stored chunk can end partway through a tag.
+    content = re.sub(r"<!--.*?-->", " ", content, flags=re.S)
+    content = re.sub(r"<style[^>]*>(?:(?!</style>).)*$|<[^>]*$", " ", content, flags=re.S | re.I)
+    text = _plain_text(content)
+    return " ".join(text.split())[:200]
+
+
+def _load(conn: sqlite3.Connection) -> list[dict]:
+    rows = conn.execute(
+        "SELECT doc_id, title, author, timestamp, url, metadata, content"
+        " FROM knowledge_chunks WHERE source = 'gmail' AND doc_type = 'email'"
+        " AND deleted_at IS NULL AND chunk_index = 0"
+    ).fetchall()
+    emails = []
+    for doc_id, title, author, ts, url, meta, snippet in rows:
+        try:
+            meta = json.loads(meta or "{}")
+        except json.JSONDecodeError:
+            meta = {}
+        account = meta.get("account", "")
+        emails.append({
+            "doc_id": doc_id,
+            "account": account,
+            "sender": author or "",
+            "subject": title or "",
+            "received_at": _utc(ts),
+            "snippet": _snippet(snippet or ""),
+            "url": gmail_link(account, meta.get("message_id", ""), url or ""),
+        })
+    emails.sort(key=lambda e: e["received_at"], reverse=True)
+    return emails
+
+
+def all_emails() -> list[dict]:
+    try:
+        conn = _connect()
+    except sqlite3.OperationalError:
+        return []
+    try:
+        key = conn.execute(
+            "SELECT max(rowid), count(*) FROM knowledge_chunks WHERE source = 'gmail'"
+            " AND deleted_at IS NULL").fetchone()
+        with _lock:
+            if _cache["key"] != key:
+                _cache["emails"] = _load(conn)
+                _cache["key"] = key
+            return _cache["emails"]
+    finally:
+        conn.close()
+
+
+def list_emails(account: str = "", q: str = "", offset: int = 0, limit: int = 50) -> dict:
+    """Newest first, filtered by account and a search over subject, sender and preview."""
+    emails = all_emails()
+    counts: dict[str, int] = {}
+    for e in emails:
+        counts[e["account"]] = counts.get(e["account"], 0) + 1
+    if account:
+        emails = [e for e in emails if e["account"] == account]
+    words = q.lower().split()
+    if words:
+        emails = [e for e in emails
+                  if all(w in f"{e['subject']} {e['sender']} {e['snippet']}".lower() for w in words)]
+    limit = max(1, min(limit, 200))
+    offset = max(0, offset)
+    return {
+        "emails": emails[offset:offset + limit],
+        "total": len(emails),
+        "accounts": [{"account": a, "count": n} for a, n in sorted(counts.items())],
+    }
diff --git a/src/openjarvis/personal/jobs.py b/src/openjarvis/personal/jobs.py
new file mode 100644
index 00000000..d1cf73ae
--- /dev/null
+++ b/src/openjarvis/personal/jobs.py
@@ -0,0 +1,588 @@
+"""Daily internship and job search with tailored application drafts.
+
+Search terms go to the configured web search engine (You.com keyless tier by
+default); nothing personal is sent. Fit scoring and drafting run on the local
+model. Drafts are saved for the user to review — nothing is ever submitted.
+
+Resume tailoring is deliberately narrow: the model rewrites only the Profile
+paragraph and picks the project order, and the resume is assembled from one of
+the user's two base resumes (set in Settings). It cannot add experience.
+"""
+
+from __future__ import annotations
+
+import json
+import logging
+import re
+from pathlib import Path
+from typing import Any
+
+from openjarvis.personal import llm
+from openjarvis.personal.store import PersonalStore, load_settings, now_local, personal_dir
+
+logger = logging.getLogger(__name__)
+
+AGENT = "jobs"
+_DATE_RE = re.compile(r"^\d{4}-\d{2}-\d{2}$")
+RESUME_FOCUSES = {
+    "it": "Technical roles",
+    "business": "Other roles",
+}
+
+
+# -- resume handling ----------------------------------------------------------
+
+
+def resume_path(focus: str) -> Path:
+    return personal_dir() / "resumes" / f"{focus}.md"
+
+
+def read_resume(focus: str) -> str:
+    try:
+        return resume_path(focus).read_text(encoding="utf-8")
+    except OSError:
+        return ""
+
+
+def save_resume(focus: str, text: str) -> None:
+    path = resume_path(focus)
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_text(text, encoding="utf-8")
+
+
+def _excluded(settings: dict[str, Any]) -> re.Pattern | None:
+    terms = [re.escape(t.strip()) for t in settings.get("never_mention") or [] if t.strip()]
+    return re.compile("|".join(terms), re.IGNORECASE) if terms else None
+
+
+def load_resume(focus: str, settings: dict[str, Any]) -> str:
+    """The base resume for ``focus``, falling back to the other one if it is empty."""
+    body = read_resume(focus).strip() or next(
+        (read_resume(f).strip() for f in RESUME_FOCUSES if read_resume(f).strip()), "")
+    if not body:
+        raise ValueError("No resume yet: paste one in Settings > Job search")
+    excluded = _excluded(settings)
+    if excluded and excluded.search(body):
+        raise ValueError("The resume mentions something on the never-mention list")
+    return body
+
+
+def _sections(body: str) -> list[tuple[str, str]]:
+    """Split the resume body into (heading, text) on ``### `` headings."""
+    parts = re.split(r"(?m)^### ", body)
+    out = [("", parts[0])]
+    for part in parts[1:]:
+        heading, _, rest = part.partition("\n")
+        out.append((heading.strip(), rest))
+    return out
+
+
+def _project_blocks(text: str) -> tuple[str, list[str]]:
+    """Split a projects section into its intro and blocks starting with ``**``."""
+    blocks = re.split(r"(?m)^(?=\*\*)", text)
+    return blocks[0], [b for b in blocks[1:] if b.strip()]
+
+
+def _block_title(block: str) -> str:
+    m = re.match(r"\*\*(.+?)\*\*", block)
+    return m.group(1) if m else block[:60]
+
+
+def tailor_resume(body: str, profile: str, project_order: list[str]) -> str:
+    out = []
+    for heading, text in _sections(body):
+        if heading == "Profile" and profile:
+            text = f"\n{profile.strip()}\n\n"
+        elif "Projects" in heading and project_order:
+            intro, blocks = _project_blocks(text)
+            rank = {t.lower(): i for i, t in enumerate(project_order)}
+            blocks.sort(key=lambda b: next(
+                (i for t, i in rank.items() if t and t in _block_title(b).lower()),
+                len(rank)))
+            text = intro + "".join(b if b.endswith("\n\n") else b.rstrip() + "\n\n"
+                                   for b in blocks)
+        out.append(f"### {heading}\n{text}" if heading else text)
+    return "".join(out).rstrip() + "\n"
+
+
+# -- search -------------------------------------------------------------------
+
+
+def parse_results(content: str) -> list[dict[str, str]]:
+    results = []
+    for chunk in content.split("\n\n---\n\n"):
+        m = re.match(r"### (.*?)\nSource: (\S*)\nSummary: (.*)", chunk.strip(), re.S)
+        if m and m.group(2).startswith("http"):
+            results.append({"title": m.group(1).strip(), "url": m.group(2).strip(),
+                            "snippet": m.group(3).strip()[:1200]})
+    return results
+
+
+def search(query: str, max_results: int) -> list[dict[str, str]]:
+    from openjarvis.tools.web_search import WebSearchTool
+
+    result = WebSearchTool().execute(query=query, max_results=max_results)
+    if not result.success:
+        raise RuntimeError(result.content)
+    return parse_results(result.content)
+
+
+# Job boards answer 403 to non-browser user agents.
+_BROWSER_HEADERS = {
+    "User-Agent": ("Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 "
+                   "(KHTML, like Gecko) Chrome/128.0 Safari/537.36"),
+}
+
+
+def fetch_html(url: str) -> str:
+    import httpx
+
+    from openjarvis.security.ssrf import check_ssrf
+
+    error = check_ssrf(url)
+    if error:
+        raise ValueError(error)
+    resp = httpx.get(url, headers=_BROWSER_HEADERS, follow_redirects=True,
+                     timeout=30.0)
+    resp.raise_for_status()
+    return resp.text
+
+
+def html_to_text(page: str) -> str:
+    import html as html_lib
+
+    page = re.sub(r"<(script|style|noscript|svg)[^>]*>.*?</\1>", " ", page,
+                  flags=re.S | re.I)
+    return " ".join(html_lib.unescape(re.sub(r"<[^>]+>", " ", page)).split())
+
+
+def fetch_page(url: str, max_chars: int = 6000) -> str:
+    try:
+        return html_to_text(fetch_html(url))[:max_chars]
+    except Exception as exc:
+        logger.info("Could not fetch %s: %s", url, exc)
+        return ""
+
+
+# Individual job links on the boards that allow fetching. Other boards
+# (Indeed, Prosple, Glassdoor) refuse automated requests.
+_JOB_LINK_PATTERNS = [
+    re.compile(r"^(?:https?://[^/]*gradconnection\.com)?(/employers/[^/]+/jobs/[^/?#]+/?)"),
+    re.compile(r"^(?:https?://[^/]*seek\.com(?:\.au)?)?(/job/\d+)"),
+]
+
+
+def expand_listing(url: str) -> list[dict[str, str]]:
+    """Pull individual job links and titles out of a job-board search page."""
+    from urllib.parse import urljoin
+
+    try:
+        page = fetch_html(url)
+    except Exception as exc:
+        logger.info("Could not expand %s: %s", url, exc)
+        return []
+    found: dict[str, str] = {}
+    for href, inner in re.findall(r'<a\b[^>]*href="([^"]+)"[^>]*>(.*?)</a>', page, re.S):
+        href = href.replace("&amp;", "&")
+        for pattern in _JOB_LINK_PATTERNS:
+            m = pattern.match(href)
+            if m:
+                job_url = urljoin(url, m.group(1))
+                title = html_to_text(inner)
+                if title or job_url not in found:
+                    found[job_url] = title or found.get(job_url, "")
+                break
+    return [{"url": u, "title": t, "snippet": t} for u, t in found.items() if t]
+
+
+# -- model steps --------------------------------------------------------------
+
+_ASSESS_SYSTEM = """You screen job search results for a job seeker. Today is {today}.
+
+Candidate profile:
+{profile}
+{about}
+The candidate is looking for: {category}.
+
+Decide what the search result is:
+- "posting": one specific job, internship or graduate program the candidate could apply to. An employer's own page for its internship, vacationer or graduate program counts as a posting.
+- "listing_page": a job board or search page listing roles from many employers.
+- "not_a_job": anything else (articles, advice, expired or unrelated pages).
+
+For a posting, score four parts. Be strict: a typical relevant posting lands around 50-65 in total, and full marks on a part need clear evidence in the result.
+- eligible (0-30): 30 only if the result shows the candidate can apply under these rules: {eligibility} 15 if eligibility is unclear; 0 if the candidate is clearly ineligible.
+- field_match (0-30): how closely the role's field fits what the candidate wants ({target_fields}). Adjacent fields get about 10-15. Unrelated fields get 0.
+- skills_match (0-25): whether the posting asks for things the candidate's profile shows they have actually done. A generic posting gets about 8.
+- practical (0-15): location ({locations}), timing that works for the candidate, and still open.
+region is where the role is based (a city, "Remote" or "Other"). work_period is when the internship or program runs as the result states it (for example "Jun-Jul 2027"), or "".
+restricted is true if the role is limited to a group the candidate is not stated to belong to (for example a gender, citizenship or a security clearance); name the restriction in "why".
+
+Use only what the result says; leave unknown fields as "". closing_date must be YYYY-MM-DD or "". needs_cover_letter is true if the result says a cover letter is required, or the role is a corporate internship or graduate program; false for casual retail or hospitality. resume_focus is "it" for technology, cyber or data roles and "business" otherwise.
+
+{untrusted}
+
+Reply with only a JSON object:
+{{"kind": "posting"|"listing_page"|"not_a_job", "title": "", "company": "", "location": "", "region": "", "work_period": "", "job_type": "internship"|"graduate"|"part-time"|"casual"|"full-time"|"", "closing_date": "", "eligible": 0, "field_match": 0, "skills_match": 0, "practical": 0, "restricted": false, "why": "<one sentence>", "needs_cover_letter": false, "resume_focus": "it"|"business"}}"""
+
+
+def assess(result: dict[str, str], category: str, profile: str,
+           settings: dict[str, Any] | None = None) -> dict[str, Any]:
+    p = (settings or load_settings())["profile"]
+    system = _ASSESS_SYSTEM.format(
+        today=now_local().date().isoformat(), profile=profile, category=category,
+        about=f"Other facts: {p['about']}" if p["about"].strip() else "",
+        eligibility=p["eligibility"].strip() or "no special rules were given.",
+        target_fields=p["target_fields"].strip() or "the search category",
+        locations=p["locations"].strip() or "anywhere practical",
+        untrusted=llm.UNTRUSTED_NOTE)
+    user = f"Title: {result['title']}\nURL: {result['url']}\n\n{result['snippet']}"
+    return llm.chat_json(system, user, temperature=0)
+
+
+_TAILOR_SYSTEM = """You tailor a resume to a job posting. You may ONLY use facts that appear in the resume below. Never add skills, employers, results or numbers that are not in it, and never claim a skill just because the posting asks for it.
+
+Return:
+- "profile": a new 3-4 sentence Profile paragraph aimed at this posting, built only from facts in the resume. Mirror the posting's key terms where the resume genuinely supports them.
+- "project_order": the resume's project titles, most relevant to this posting first, copied exactly.
+
+Resume:
+{resume}
+
+{untrusted}
+
+Reply with only a JSON object: {{"profile": "", "project_order": [""]}}"""
+
+_LETTER_SYSTEM = """You write a cover letter for the candidate applying to the posting below. Use ONLY facts from the resume; never invent experience, results or numbers. Accuracy rules:
+- Restate a project detail only as the resume words it. Never merge facts from different bullets or projects into one claim.
+- Never say where or for whom something happened unless the resume says so.
+- Copy any number exactly as it appears in the resume, or leave it out.
+- Prefer two accurate details over many loose ones.
+- Claim a skill only if the resume shows it through a named course, project, hackathon or case competition. Never claim a skill just because the posting asks for it; if the posting wants something the resume does not show, leave it out.
+Professional and warm, about 300 words, 4 short paragraphs: why this role and organisation, two pieces of evidence from the resume that match the posting, what the candidate would bring, a brief close. {signoff} Output the letter text only, no commentary.
+
+Resume:
+{resume}
+
+{untrusted}"""
+
+
+def _posting_text(job: dict[str, Any], page: str, snippet: str) -> str:
+    return (f"Role: {job['title']}\nOrganisation: {job['company']}\n"
+            f"Location: {job['location']}\nURL: {job['url']}\n\n"
+            f"{page or snippet}")
+
+
+def read_drafts(path: str) -> dict[str, str]:
+    """Split a draft note into its tailored resume and cover letter sections."""
+    try:
+        text = Path(path).read_text(encoding="utf-8")
+    except (OSError, ValueError):
+        return {"resume": "", "cover_letter": ""}
+    resume, _, letter = text.partition("## Cover letter")
+    resume = resume.partition("## Tailored resume")[2]
+    return {"resume": resume.strip(), "cover_letter": letter.strip()}
+
+
+def draft_job(job_id: int) -> Path:
+    """Write drafts for one job on request, always including a cover letter."""
+    settings = load_settings()
+    with PersonalStore() as store:
+        job = store.get_job(job_id)
+        if job is None:
+            raise KeyError(job_id)
+        path = write_drafts(job, job["description"] or job["why"], settings,
+                            force_letter=True)
+        store.update_job(job_id, resume_draft=str(path), cover_letter_draft=str(path))
+    return path
+
+
+def write_drafts(job: dict[str, Any], snippet: str, settings: dict[str, Any],
+                 *, force_letter: bool = False) -> Path:
+    focus = job["resume_focus"] if job["resume_focus"] in RESUME_FOCUSES else "business"
+    resume = load_resume(focus, settings)
+    excluded = _excluded(settings)
+    posting = _posting_text(job, fetch_page(job["url"]), snippet)
+
+    tailored = llm.chat_json(
+        _TAILOR_SYSTEM.format(resume=resume, untrusted=llm.UNTRUSTED_NOTE),
+        posting, temperature=0.2)
+    profile = str(tailored.get("profile", "")).strip()
+    if excluded and excluded.search(profile):
+        profile = ""
+    resume_md = tailor_resume(resume, profile,
+                              [str(t) for t in tailored.get("project_order") or []])
+
+    letter = ""
+    if job["needs_cover_letter"] or force_letter:
+        letter = llm.chat(_LETTER_SYSTEM.format(resume=resume, signoff=_signoff(settings),
+                                                untrusted=llm.UNTRUSTED_NOTE),
+                          posting, temperature=0.4).strip()
+        if excluded and excluded.search(letter):
+            letter = ""
+            logger.warning("Dropped a cover letter that mentioned a never-mention term")
+    unsupported = unsupported_numbers(letter, resume + "\n" + posting)
+
+    today = now_local().date().isoformat()
+    safe = lambda s: re.sub(r'[\\/:*?"<>|#^\[\]]+', " ", s).strip()[:60]  # noqa: E731
+    name = f"{today} {safe(job['company']) or 'Unknown'} — {safe(job['title'])}.md"
+    out_dir = drafts_dir(settings)
+    out_dir.mkdir(parents=True, exist_ok=True)
+    path = out_dir / name
+
+    check = (
+        "> [!danger] Check these numbers\n> The letter uses "
+        + ", ".join(unsupported)
+        + ", which do not appear in the resume or the posting.\n\n"
+        if unsupported else ""
+    )
+    letter_section = (
+        f"## Cover letter\n\n{check}{letter}\n" if letter
+        else "## Cover letter\n\nNot drafted: the posting did not look like it needs one.\n"
+    )
+    path.write_text(
+        "---\n"
+        f"date: {today}\n"
+        f"description: \"Draft application for {job['title']} at "
+        f"{job['company'] or 'unknown organisation'} (fit {job['fit']}). Review before using.\"\n"
+        "tags:\n  - career\n  - application\n  - draft\n"
+        "status: draft\n"
+        "---\n\n"
+        f"# {job['title']} — {job['company']}\n\n"
+        "> [!warning] Draft written by the local job agent\n"
+        "> Check every line against your own resume before sending. Nothing has been submitted.\n\n"
+        f"- **Posting:** {job['url']}\n"
+        f"- **Closes:** {job['closing_date'] or 'not stated'}\n"
+        f"- **Fit:** {job['fit']}/100 — {job['why']}\n"
+        f"- **Base resume:** {RESUME_FOCUSES[focus]}\n\n"
+        f"## Tailored resume\n\n{resume_md}\n"
+        f"{letter_section}",
+        encoding="utf-8",
+    )
+    return path
+
+
+def drafts_dir(settings: dict[str, Any]) -> Path:
+    return Path(settings["drafts_dir"]) if settings.get("drafts_dir") else personal_dir() / "drafts"
+
+
+def _signoff(settings: dict[str, Any]) -> str:
+    p = settings["profile"]
+    contact = ", ".join(x for x in (p["email"], p["phone"]) if x.strip())
+    if not p["name"].strip():
+        return "End with a plain sign-off and leave the name blank for the candidate to fill in."
+    return f"Sign off as {p['name']}" + (f" ({contact})." if contact else ".")
+
+
+def unsupported_numbers(text: str, sources: str) -> list[str]:
+    """Numbers in ``text`` that never appear in ``sources`` (a cheap fact check)."""
+    known = set(re.findall(r"\d+(?:[.,]\d+)*", sources))
+    found = re.findall(r"\d+(?:[.,]\d+)*", text)
+    return sorted({n for n in found if n not in known}, key=found.index)
+
+
+def trim_to_title(title: str, text: str) -> str:
+    """Drop site navigation before the first mention of the job title."""
+    idx = text.lower().find(title.lower().strip()) if title.strip() else -1
+    return text[idx:] if idx > 0 else text
+
+
+_FIT_PARTS = {"eligible": 30, "field_match": 30, "skills_match": 25, "practical": 15}
+
+
+def fit_score(a: dict[str, Any]) -> int:
+    """Sum the capped sub-scores; ineligible or restricted roles never exceed 20."""
+    total = 0
+    for part, cap in _FIT_PARTS.items():
+        try:
+            total += max(0, min(cap, int(a.get(part) or 0)))
+        except (TypeError, ValueError):
+            pass
+    capped = a.get("restricted") or str(a.get("eligible", "")).strip() == "0"
+    return min(total, 20) if capped else total
+
+
+_MONTHS = {m: i for i, m in enumerate(
+    ["jan", "feb", "mar", "apr", "may", "jun", "jul", "aug", "sep", "oct", "nov", "dec"], 1)}
+_MONTH_RE = re.compile(r"\b(" + "|".join(_MONTHS) + r")[a-z]*\.?", re.I)
+
+
+def stated_months(period: str) -> set[int]:
+    """Months covered by a work period like "Jun-Jul 2027" or "Dec 2026 - Feb 2027"."""
+    found = [_MONTHS[m.group(1).lower()] for m in _MONTH_RE.finditer(period)]
+    if len(found) < 2:
+        return set(found)
+    start, end = found[0], found[-1]
+    span = (end - start) % 12
+    return {(start - 1 + i) % 12 + 1 for i in range(span + 1)}
+
+
+def ineligible_reason(job: dict[str, Any], settings: dict[str, Any] | None = None) -> str:
+    """Why the candidate cannot apply, from the Settings exclude phrases; "" if none match.
+
+    The model does not reliably apply eligibility rules written in prose, so
+    hard rules are enforced here as plain phrase matches.
+    """
+    phrases = (settings or load_settings()).get("exclude_phrases") or []
+    text = "\n".join(str(job.get(k) or "") for k in ("title", "work_period", "description")).lower()
+    for phrase in phrases:
+        if phrase.strip() and phrase.strip().lower() in text:
+            return f'mentions "{phrase.strip()}"'
+    return ""
+
+
+def apply_eligibility(job: dict[str, Any], settings: dict[str, Any] | None = None) -> bool:
+    """Cap the fit of an ineligible posting at 20 and say why; True if capped."""
+    reason = ineligible_reason(job, settings)
+    if not reason or job.get("fit") is None:
+        return False
+    job["fit"] = min(int(job["fit"]), 20)
+    if not job.get("why", "").startswith("Ineligible:"):
+        job["why"] = f"Ineligible: {reason}. {job.get('why', '')}".strip()[:300]
+    return True
+
+
+def recap_stored(store: PersonalStore) -> list[dict[str, Any]]:
+    """Re-apply the eligibility cap to stored postings and drop their deadlines."""
+    capped = []
+    for job in store.postings():
+        before = job["fit"]
+        if apply_eligibility(job):
+            store.update_job(job["id"], fit=job["fit"], why=job["why"])
+            store.remove_deadlines("job", job["url"])
+            capped.append(dict(job, fit_before=before))
+    return capped
+
+
+def pick_for_drafts(candidates: list, max_drafts: int) -> list:
+    """Best-fit first, at most one role per company so drafts are not duplicates."""
+    picked, companies = [], set()
+    for job, r in candidates:
+        company = re.sub(r"[^a-z0-9]+", " ", job["company"].lower()).strip()
+        if company and company in companies:
+            continue
+        companies.add(company)
+        picked.append((job, r))
+        if len(picked) >= max_drafts:
+            break
+    return picked
+
+
+# -- run ----------------------------------------------------------------------
+
+
+def _profile_paragraph(settings: dict[str, Any]) -> str:
+    """The resume's Profile section, or the start of the resume if it has none."""
+    body = load_resume("it", settings)
+    for heading, text in _sections(body):
+        if heading == "Profile":
+            return text.strip()
+    return body[:1500]
+
+
+def run(*, max_drafts: int | None = None) -> dict[str, Any]:
+    settings = load_settings()
+    max_drafts = settings["max_drafts_per_run"] if max_drafts is None else max_drafts
+    threshold = int(settings["fit_threshold_for_drafts"])
+    stats = {"searches": 0, "results": 0, "new": 0, "postings": 0,
+             "good_matches": 0, "drafts": 0, "errors": 0}
+
+    with PersonalStore() as store:
+        store.run_started(AGENT)
+        try:
+            profile = _profile_paragraph(settings)
+            known = store.job_urls()
+            candidates: list[tuple[dict[str, Any], dict[str, str]]] = []
+
+            for s in settings["job_searches"]:
+                try:
+                    results = search(s["query"], int(settings["results_per_search"]))
+                except Exception as exc:
+                    logger.error("Search failed for %r: %s", s["query"], exc)
+                    stats["errors"] += 1
+                    continue
+                stats["searches"] += 1
+                stats["results"] += len(results)
+                # A queue so roles pulled out of a listing page get the same
+                # treatment as direct results; expanded roles are not re-expanded.
+                queue = [(r, True) for r in results]
+                while queue:
+                    r, expandable = queue.pop(0)
+                    if r["url"] in known:
+                        continue
+                    known.add(r["url"])
+                    stats["new"] += 1
+                    if not expandable:
+                        page = fetch_page(r["url"], max_chars=5000)
+                        if page:
+                            r = dict(r, snippet=page)
+                    try:
+                        a = assess(r, s["category"], profile, settings)
+                    except Exception as exc:
+                        logger.error("Assess failed for %s: %s", r["url"], exc)
+                        stats["errors"] += 1
+                        continue
+                    kind = a.get("kind") if a.get("kind") in (
+                        "posting", "listing_page", "not_a_job") else "not_a_job"
+                    closing = str(a.get("closing_date") or "")
+                    job = {
+                        "url": r["url"],
+                        "title": str(a.get("title") or r["title"])[:200],
+                        "company": str(a.get("company") or "")[:120],
+                        "location": str(a.get("location") or "")[:120],
+                        "job_type": str(a.get("job_type") or "")[:40],
+                        "search_category": s["category"],
+                        "kind": kind,
+                        "closing_date": closing if _DATE_RE.match(closing) else "",
+                        "fit": fit_score(a) if kind == "posting" else None,
+                        "why": str(a.get("why") or "")[:300],
+                        "needs_cover_letter": int(bool(a.get("needs_cover_letter"))),
+                        "resume_focus": a.get("resume_focus")
+                                        if a.get("resume_focus") in RESUME_FOCUSES
+                                        else "business",
+                        "region": str(a.get("region") or "")[:40],
+                        "work_period": str(a.get("work_period") or "")[:60],
+                        "description": "",
+                    }
+                    if kind == "posting":
+                        # Expanded roles already carry their page text.
+                        job["description"] = trim_to_title(job["title"], r["snippet"] if not expandable
+                                              else fetch_page(r["url"]) or r["snippet"])
+                        apply_eligibility(job, settings)
+                    job["id"] = store.add_job(job)
+                    if kind == "listing_page" and expandable:
+                        roles = [x for x in expand_listing(r["url"])
+                                 if x["url"] not in known]
+                        per_page = int(settings["roles_per_listing_page"])
+                        queue.extend((x, False) for x in roles[:per_page])
+                    if kind == "posting":
+                        stats["postings"] += 1
+                        # Only roles worth applying for get a deadline, so
+                        # the dashboard list stays short.
+                        if job["closing_date"] and job["fit"] >= threshold:
+                            store.add_deadline(
+                                job["closing_date"],
+                                f"Applications close: {job['title']}"
+                                f"{' — ' + job['company'] if job['company'] else ''}",
+                                "job", job["url"])
+                        if job["fit"] >= threshold:
+                            stats["good_matches"] += 1
+                            candidates.append((job, r))
+
+            candidates.sort(key=lambda c: c[0]["fit"], reverse=True)
+            for job, r in pick_for_drafts(candidates, max_drafts):
+                try:
+                    path = write_drafts(job, r["snippet"], settings)
+                except Exception as exc:
+                    logger.error("Drafting failed for %s: %s", job["url"], exc)
+                    stats["errors"] += 1
+                    continue
+                store.update_job(job["id"], resume_draft=str(path),
+                                 cover_letter_draft=str(path)
+                                 if job["needs_cover_letter"] else "")
+                stats["drafts"] += 1
+        except Exception as exc:
+            store.run_finished(AGENT, "error", str(exc))
+            raise
+        store.run_finished(AGENT, "ok" if not stats["errors"] else "partial",
+                           json.dumps(stats))
+    return stats
