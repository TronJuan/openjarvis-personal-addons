@@ -0,0 +1,55 @@
+"""Entry point for Windows Task Scheduler: ``pythonw -m openjarvis.personal.runner``.
+
+Runs one agent with no console and logs to ``personal/agents.log``.
+"""
+
+from __future__ import annotations
+
+import json
+import logging
+import sys
+from logging.handlers import RotatingFileHandler
+
+from openjarvis.personal.store import personal_dir
+
+
+def main(argv: list[str]) -> int:
+    agent = argv[0] if argv else ""
+    handler = RotatingFileHandler(personal_dir() / "agents.log",
+                                  maxBytes=2_000_000, backupCount=2,
+                                  encoding="utf-8")
+    logging.basicConfig(level=logging.INFO, handlers=[handler],
+                        format="%(asctime)s %(levelname)s %(name)s: %(message)s")
+    logging.getLogger("httpx").setLevel(logging.WARNING)
+    log = logging.getLogger("openjarvis.personal.runner")
+
+    try:
+        if agent == "eventmate":
+            from openjarvis.personal import eventmate
+
+            if eventmate.is_running():
+                log.info("eventmate already running; skipped")
+                return 0
+            stats = eventmate.run()
+        elif agent == "jobs":
+            from openjarvis.personal import jobs
+
+            stats = jobs.run()
+        elif agent == "inbox-backfill":
+            from openjarvis.personal import eventmate
+
+            accounts = frozenset(a.lower() for a in argv[1:])
+            log.info("inbox backfill started for %s", ", ".join(sorted(accounts)) or "no accounts")
+            stats = {"synced": eventmate.sync_gmail(None, backfill=accounts)}
+        else:
+            log.error("unknown agent %r (expected eventmate, jobs or inbox-backfill)", agent)
+            return 2
+    except Exception:
+        log.exception("%s run failed", agent)
+        return 1
+    log.info("%s finished: %s", agent, json.dumps(stats))
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main(sys.argv[1:]))
