diff --git a/frontend/src/components/PersonalAgentsSettings.tsx b/frontend/src/components/PersonalAgentsSettings.tsx
new file mode 100644
index 00000000..cbecfa11
--- /dev/null
+++ b/frontend/src/components/PersonalAgentsSettings.tsx
@@ -0,0 +1,303 @@
+import { useEffect, useState } from 'react';
+import { Play, Plus, Trash2 } from 'lucide-react';
+import { toast } from 'sonner';
+import { apiFetch } from '../lib/api';
+
+interface Profile {
+  name: string;
+  email: string;
+  phone: string;
+  linkedin: string;
+  about: string;
+  eligibility: string;
+  target_fields: string;
+  locations: string;
+}
+
+interface Search {
+  category: string;
+  query: string;
+}
+
+interface PersonalSettings {
+  profile: Profile;
+  job_searches: Search[];
+  exclude_phrases: string[];
+  never_mention: string[];
+  todo_files: string[];
+  fit_threshold_for_drafts: number;
+  max_drafts_per_run: number;
+}
+
+interface Resume {
+  focus: string;
+  label: string;
+  text: string;
+}
+
+interface AgentRun {
+  agent: string;
+  last_started?: number;
+  last_finished?: number;
+  last_status?: string;
+}
+
+const AGENT_LABELS: Record<string, string> = { eventmate: 'Event Mate and inbox triage', jobs: 'Job search' };
+
+const PROFILE_FIELDS: { key: keyof Profile; label: string; placeholder: string; long?: boolean }[] = [
+  { key: 'name', label: 'Name', placeholder: 'Used to sign cover letters and fill application forms' },
+  { key: 'email', label: 'Email', placeholder: 'you@example.com' },
+  { key: 'phone', label: 'Phone', placeholder: '+61 400 000 000' },
+  { key: 'linkedin', label: 'LinkedIn', placeholder: 'linkedin.com/in/you' },
+  { key: 'about', label: 'About you', long: true,
+    placeholder: 'Facts the job agent can rely on that are not on your resume: what you study and when you graduate, work rights, languages, licence.' },
+  { key: 'eligibility', label: 'Who you can apply as', long: true,
+    placeholder: 'e.g. Final-year student graduating June 2028 with full work rights in Australia. Graduate programs must start after July 2028.' },
+  { key: 'target_fields', label: 'Fields you want', placeholder: 'e.g. software engineering, cybersecurity or data' },
+  { key: 'locations', label: 'Locations', placeholder: 'e.g. Melbourne or remote' },
+];
+
+const lines = (text: string) => text.split('\n').map((s) => s.trim()).filter(Boolean);
+
+const ago = (t?: number) => {
+  if (!t) return 'never';
+  const mins = Math.round((Date.now() / 1000 - t) / 60);
+  if (mins < 1) return 'just now';
+  if (mins < 60) return `${mins} min ago`;
+  if (mins < 48 * 60) return `${Math.round(mins / 60)} h ago`;
+  return `${Math.round(mins / 1440)} days ago`;
+};
+
+export function PersonalAgentsSettings() {
+  const [settings, setSettings] = useState<PersonalSettings | null>(null);
+  const [resumes, setResumes] = useState<Resume[]>([]);
+  const [preferences, setPreferences] = useState('');
+  const [domains, setDomains] = useState('');
+  const [keywords, setKeywords] = useState('');
+  const [runs, setRuns] = useState<AgentRun[]>([]);
+  const [dirty, setDirty] = useState(false);
+  const [saving, setSaving] = useState(false);
+
+  const loadRuns = () =>
+    apiFetch('/api/personal/agents').then((r) => r.json()).then((d) => setRuns(d.agents)).catch(() => {});
+
+  const load = async () => {
+    try {
+      const [s, r, p, w] = await Promise.all(
+        ['/api/personal/settings', '/api/personal/resumes', '/api/personal/event-preferences', '/api/personal/whitelist']
+          .map((path) => apiFetch(path).then((res) => res.json())),
+      );
+      setSettings(s);
+      setResumes(r.resumes);
+      setPreferences(p.text);
+      setDomains(w.sender_domains.join(', '));
+      setKeywords(w.keywords.join(', '));
+      setDirty(false);
+    } catch {
+      toast.error("Couldn't load personal agent settings");
+    }
+  };
+
+  useEffect(() => {
+    load();
+    loadRuns();
+    const timer = setInterval(loadRuns, 10000);
+    return () => clearInterval(timer);
+  }, []);
+
+  if (!settings) return null;
+
+  const change = (patch: Partial<PersonalSettings>) => { setSettings({ ...settings, ...patch }); setDirty(true); };
+  const changeProfile = (key: keyof Profile, value: string) => change({ profile: { ...settings.profile, [key]: value } });
+  const changeSearch = (i: number, patch: Partial<Search>) =>
+    change({ job_searches: settings.job_searches.map((s, j) => (j === i ? { ...s, ...patch } : s)) });
+
+  const save = async () => {
+    setSaving(true);
+    const put = (path: string, body: unknown) =>
+      apiFetch(path, { method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) })
+        .then((r) => { if (!r.ok) throw new Error(path); });
+    try {
+      await Promise.all([
+        put('/api/personal/settings', {
+          ...settings,
+          job_searches: settings.job_searches.filter((s) => s.query.trim()),
+        }),
+        ...resumes.map((r) => put(`/api/personal/resumes/${r.focus}`, { text: r.text })),
+        put('/api/personal/event-preferences', { text: preferences }),
+        put('/api/personal/whitelist', {
+          sender_domains: domains.split(',').map((s) => s.trim()).filter(Boolean),
+          keywords: keywords.split(',').map((s) => s.trim()).filter(Boolean),
+        }),
+      ]);
+      await load();
+      toast.success('Personal agent settings saved');
+    } catch {
+      toast.error("Couldn't save personal agent settings");
+    } finally {
+      setSaving(false);
+    }
+  };
+
+  const run = async (agent: string) => {
+    const r = await apiFetch(`/api/personal/agents/${agent}/run`, { method: 'POST' });
+    if (r.ok) {
+      toast.success(`${AGENT_LABELS[agent]} started. Results appear on its page when it finishes.`);
+      setTimeout(loadRuns, 2000);
+    } else {
+      toast.error(`Couldn't start ${AGENT_LABELS[agent]}`);
+    }
+  };
+
+  const input = 'w-full rounded-md px-2 py-1.5 text-sm outline-none';
+  const inputStyle = { background: 'var(--color-bg-secondary)', border: '1px solid var(--color-border)', color: 'var(--color-text)' };
+  const label = 'text-xs font-medium mb-1 block';
+  const labelStyle = { color: 'var(--color-text-secondary)' };
+  const hint = { color: 'var(--color-text-tertiary)' };
+  const heading = 'text-xs font-semibold uppercase tracking-wide mt-2';
+  const outline = { border: '1px solid var(--color-border)', color: 'var(--color-text)' };
+
+  return (
+    <div className="flex flex-col gap-4">
+      <div className="text-xs" style={hint}>
+        Event Mate checks your inbox every 15 minutes and the job search runs once a day. Both run on your local model;
+        only search terms are sent to the web search engine.
+      </div>
+
+      <div className="flex flex-col gap-2">
+        {Object.keys(AGENT_LABELS).map((agent) => {
+          const info = runs.find((r) => r.agent === agent);
+          const status = info?.last_status === 'running' ? `running, started ${ago(info.last_started)}`
+            : info?.last_finished ? `last run ${ago(info.last_finished)} (${info.last_status})` : 'not run yet';
+          return (
+            <div key={agent} className="flex items-center gap-3 rounded-lg px-3 py-2" style={{ border: '1px solid var(--color-border-subtle)' }}>
+              <div className="flex-1 min-w-0">
+                <div className="text-sm" style={{ color: 'var(--color-text)' }}>{AGENT_LABELS[agent]}</div>
+                <div className="text-xs" style={hint}>{status}</div>
+              </div>
+              <button onClick={() => run(agent)} disabled={info?.last_status === 'running'}
+                className="flex items-center gap-1.5 rounded-md px-3 py-1.5 text-sm cursor-pointer disabled:opacity-40 disabled:cursor-default"
+                style={outline}>
+                <Play size={13} /> Run now
+              </button>
+            </div>
+          );
+        })}
+      </div>
+
+      <div className={heading} style={labelStyle}>Your profile</div>
+      <div className="grid gap-3" style={{ gridTemplateColumns: 'repeat(2, minmax(0, 1fr))' }}>
+        {PROFILE_FIELDS.map((f) => (
+          <div key={f.key} style={{ gridColumn: f.long ? '1 / 3' : undefined }}>
+            <label className={label} style={labelStyle}>{f.label}</label>
+            {f.long ? (
+              <textarea className={input} style={inputStyle} rows={3} value={settings.profile[f.key]}
+                placeholder={f.placeholder} aria-label={f.label} onChange={(e) => changeProfile(f.key, e.target.value)} />
+            ) : (
+              <input className={input} style={inputStyle} value={settings.profile[f.key]}
+                placeholder={f.placeholder} aria-label={f.label} onChange={(e) => changeProfile(f.key, e.target.value)} />
+            )}
+          </div>
+        ))}
+      </div>
+
+      <div className={heading} style={labelStyle}>Resumes</div>
+      <div className="text-xs" style={hint}>
+        Paste your resume as Markdown. The job agent rewrites only a section headed <code>### Profile</code> and
+        reorders the entries in a section whose heading contains "Projects"; everything else is copied as written.
+        Fill in one or both: technical roles use the first, everything else the second.
+      </div>
+      {resumes.map((r, i) => (
+        <div key={r.focus}>
+          <label className={label} style={labelStyle}>{r.label}</label>
+          <textarea className={`${input} font-mono`} style={inputStyle} rows={8} value={r.text} aria-label={`${r.label} resume`}
+            placeholder={'## Your Name\n\n### Profile\n\nOne paragraph about you.\n\n### Projects\n\n**Project name** — 2026\n- What you did'}
+            onChange={(e) => { setResumes(resumes.map((x, j) => (j === i ? { ...x, text: e.target.value } : x))); setDirty(true); }} />
+        </div>
+      ))}
+
+      <div className={heading} style={labelStyle}>Job searches</div>
+      {settings.job_searches.map((s, i) => (
+        <div key={i} className="grid gap-2" style={{ gridTemplateColumns: '10rem minmax(0,1fr) auto' }}>
+          <input className={input} style={inputStyle} value={s.category} placeholder="Category" aria-label="Search category"
+            onChange={(e) => changeSearch(i, { category: e.target.value })} />
+          <input className={input} style={inputStyle} value={s.query} placeholder="Search terms" aria-label="Search terms"
+            onChange={(e) => changeSearch(i, { query: e.target.value })} />
+          <button onClick={() => change({ job_searches: settings.job_searches.filter((_, j) => j !== i) })}
+            title="Delete this search" aria-label="Delete this search" className="rounded-md p-2 cursor-pointer"
+            style={{ color: 'var(--color-text-secondary)' }}>
+            <Trash2 size={15} />
+          </button>
+        </div>
+      ))}
+      <div>
+        <button onClick={() => change({ job_searches: [...settings.job_searches, { category: '', query: '' }] })}
+          className="flex items-center gap-1.5 rounded-md px-3 py-1.5 text-sm cursor-pointer" style={outline}>
+          <Plus size={14} /> Add search
+        </button>
+      </div>
+      <div className="grid gap-3" style={{ gridTemplateColumns: 'repeat(2, minmax(0, 1fr))' }}>
+        <div>
+          <label className={label} style={labelStyle}>Rule out postings that mention (one per line)</label>
+          <textarea className={input} style={inputStyle} rows={3} value={settings.exclude_phrases.join('\n')}
+            placeholder={'2026/27\nsecurity clearance'} aria-label="Exclude phrases"
+            onChange={(e) => change({ exclude_phrases: lines(e.target.value) })} />
+        </div>
+        <div>
+          <label className={label} style={labelStyle}>Never mention in drafts (one per line)</label>
+          <textarea className={input} style={inputStyle} rows={3} value={settings.never_mention.join('\n')}
+            placeholder="An old job you leave off every resume" aria-label="Never mention"
+            onChange={(e) => change({ never_mention: lines(e.target.value) })} />
+        </div>
+        <div>
+          <label className={label} style={labelStyle}>Draft applications for fit scores of at least</label>
+          <input className={input} style={inputStyle} type="number" min={0} max={100} value={settings.fit_threshold_for_drafts}
+            aria-label="Fit threshold" onChange={(e) => change({ fit_threshold_for_drafts: Number(e.target.value) })} />
+        </div>
+        <div>
+          <label className={label} style={labelStyle}>Most drafts per run</label>
+          <input className={input} style={inputStyle} type="number" min={0} max={10} value={settings.max_drafts_per_run}
+            aria-label="Max drafts per run" onChange={(e) => change({ max_drafts_per_run: Number(e.target.value) })} />
+        </div>
+      </div>
+
+      <div className={heading} style={labelStyle}>Events</div>
+      <div>
+        <label className={label} style={labelStyle}>Event preferences (Event Mate scores events against this)</label>
+        <textarea className={input} style={inputStyle} rows={7} value={preferences} aria-label="Event preferences"
+          onChange={(e) => { setPreferences(e.target.value); setDirty(true); }} />
+      </div>
+      <div className="grid gap-3" style={{ gridTemplateColumns: 'repeat(2, minmax(0, 1fr))' }}>
+        <div>
+          <label className={label} style={labelStyle}>Always check mail from these domains (comma-separated)</label>
+          <textarea className={input} style={inputStyle} rows={3} value={domains} aria-label="Sender domains"
+            placeholder="university.edu, eventbrite.com" onChange={(e) => { setDomains(e.target.value); setDirty(true); }} />
+        </div>
+        <div>
+          <label className={label} style={labelStyle}>Or mail containing these words (comma-separated)</label>
+          <textarea className={input} style={inputStyle} rows={3} value={keywords} aria-label="Keywords"
+            onChange={(e) => { setKeywords(e.target.value); setDirty(true); }} />
+        </div>
+      </div>
+      <div>
+        <label className={label} style={labelStyle}>Markdown to-do files shown on the Overview (optional, one path per line)</label>
+        <textarea className={input} style={inputStyle} rows={2} value={settings.todo_files.join('\n')}
+          placeholder="C:\Notes\Tasks.md" aria-label="To-do files"
+          onChange={(e) => change({ todo_files: lines(e.target.value) })} />
+      </div>
+
+      <div className="flex gap-2">
+        <button onClick={save} disabled={!dirty || saving}
+          className="rounded-md px-3 py-1.5 text-sm font-medium cursor-pointer disabled:opacity-40 disabled:cursor-default"
+          style={{ background: 'var(--color-accent)', color: '#0b0b0d' }}>
+          {saving ? 'Saving...' : 'Save'}
+        </button>
+        {dirty && (
+          <button onClick={load} className="rounded-md px-3 py-1.5 text-sm cursor-pointer" style={{ color: 'var(--color-text-secondary)' }}>
+            Undo changes
+          </button>
+        )}
+      </div>
+    </div>
+  );
+}
