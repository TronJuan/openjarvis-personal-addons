+"""Events page backend: stored events, their source email, and the routes."""
+
+from __future__ import annotations
+
+import json
+import sqlite3
+from datetime import timedelta
+
+import pytest
+from fastapi import FastAPI
+from fastapi.testclient import TestClient
+
+from openjarvis.connectors.chunker import _apply_overlap
+from openjarvis.personal import eventmate
+from openjarvis.personal.store import PersonalStore, event_key, now_local
+from openjarvis.server.personal_routes import create_personal_router
+
+ACCOUNT = "me@example.edu"
+MSG_ID = "<abc-123@mta.example.com>"
+DOC_ID = f"gmail:{ACCOUNT}:{MSG_ID}"
+
+
+def _knowledge_db(home, doc_id=DOC_ID, chunks=("Hello &ndash; there",),
+                  timestamp="2026-09-24T08:48:00+10:00"):
+    conn = sqlite3.connect(home / "knowledge.db")
+    conn.execute(
+        "CREATE TABLE knowledge_chunks (doc_id TEXT, chunk_index INTEGER,"
+        " source TEXT, doc_type TEXT, title TEXT, author TEXT, timestamp TEXT,"
+        " url TEXT, metadata TEXT, content TEXT, deleted_at REAL)")
+    meta = json.dumps({"account": ACCOUNT, "message_id": MSG_ID})
+    # Stored out of order on purpose: chunk_index decides the order.
+    for i, content in reversed(list(enumerate(chunks))):
+        conn.execute(
+            "INSERT INTO knowledge_chunks VALUES (?,?,?,?,?,?,?,?,?,?,NULL)",
+            (doc_id, i, "gmail", "email", "Careers night", "Careers <c@example.edu>",
+             timestamp, f"https://mail.google.com/mail/?authuser={ACCOUNT}#inbox",
+             meta, content))
+    conn.commit()
+    conn.close()
+
+
+def _add_event(store, name, date, **fields):
+    return store.upsert_event(dict({"event_key": event_key(name, "", date),
+                                    "name": name, "date": date}, **fields))
+
+
+@pytest.fixture
+def home(tmp_path, monkeypatch):
+    monkeypatch.setenv("OPENJARVIS_HOME", str(tmp_path))
+    return tmp_path
+
+
+def test_join_chunks_drops_chunker_overlap():
+    originals = [
+        "First paragraph about the\ncareers night on Thursday.",
+        "Second part: meet KPMG and UNIQLO   at Clayton.",
+        "Third: register at https://example.com/rsvp before Monday.",
+    ]
+    stored = _apply_overlap(originals, overlap_tokens=4)
+    # The overlap is also cut to a character cap, so it can start mid-word.
+    assert stored[1].startswith("ght on Thursday. Second")
+    assert eventmate._join_chunks(stored) == "\n".join(originals)
+
+
+def test_join_chunks_keeps_chunks_without_overlap():
+    assert eventmate._join_chunks(["one two", "three four"]) == "one two\nthree four"
+    assert eventmate._join_chunks([]) == ""
+
+
+def test_plain_text_unescapes_entities_without_tags():
+    assert eventmate._plain_text("4&ndash;7pm, don&rsquo;t") == "4–7pm, don’t"
+    assert eventmate._plain_text("Hi \n \n \n \n  there") == "Hi\n\nthere"
+
+
+def test_gmail_link_targets_the_message():
+    link = eventmate.gmail_link(ACCOUNT, MSG_ID, "fallback")
+    assert link == ("https://mail.google.com/mail/?authuser=me@example.edu"
+                    "#search/rfc822msgid%3Aabc-123%40mta.example.com")
+    assert eventmate.gmail_link(ACCOUNT, "", "fallback") == "fallback"
+
+
+def test_load_email(home):
+    _knowledge_db(home, chunks=_apply_overlap(
+        ["<p>Careers night &amp; drinks</p>", "Thursday 4pm at Clayton"], overlap_tokens=3))
+    email = eventmate.load_email(DOC_ID)
+    assert email.subject == "Careers night"
+    assert email.sender == "Careers <c@example.edu>"
+    assert email.account == ACCOUNT
+    assert email.received_at == "2026-09-23T22:48:00+00:00"
+    assert email.body == "Careers night & drinks\n\nThursday 4pm at Clayton"
+    assert "rfc822msgid" in email.url
+
+
+def test_load_email_missing(home):
+    assert eventmate.load_email(DOC_ID) is None  # no knowledge.db at all
+    _knowledge_db(home)
+    assert eventmate.load_email("gmail:other:<x>") is None
+
+
+def test_list_events_hides_rejected_and_past(tmp_path):
+    today = now_local().date()
+    with PersonalStore(tmp_path / "p.db") as store:
+        _add_event(store, "Past", (today - timedelta(days=1)).isoformat(), score=90)
+        _add_event(store, "Hidden", today.isoformat(), status="Rejected", score=90)
+        _add_event(store, "Undated", "", score=50)
+        _add_event(store, "Today", today.isoformat(), score=80)
+        _add_event(store, "Unscored", today.isoformat())
+        names = [e["name"] for e in store.list_events()]
+    assert names == ["Today", "Undated", "Unscored"]
+
+
+def test_event_routes(home):
+    _knowledge_db(home)
+    today = now_local().date().isoformat()
+    with PersonalStore() as store:
+        with_email = _add_event(store, "Careers night", today, source_doc_id=DOC_ID)
+        no_email = _add_event(store, "Walk-in", today)
+    app = FastAPI()
+    app.include_router(create_personal_router())
+    client = TestClient(app)
+
+    assert {e["id"] for e in client.get("/api/personal/events").json()["events"]} == {
+        with_email, no_email}
+
+    detail = client.get(f"/api/personal/events/{with_email}").json()
+    assert detail["name"] == "Careers night"
+    assert detail["email"]["subject"] == "Careers night"
+    assert detail["email"]["body"] == "Hello – there"
+    assert client.get(f"/api/personal/events/{no_email}").json()["email"] is None
+    assert client.get("/api/personal/events/999").status_code == 404
+
+    assert client.post(f"/api/personal/events/{with_email}/dismiss").json() == {"ok": True}
+    assert [e["id"] for e in client.get("/api/personal/events").json()["events"]] == [no_email]
+    assert client.get(f"/api/personal/events/{with_email}").json()["status"] == "Rejected"
+    assert client.post("/api/personal/events/999/dismiss").status_code == 404
