diff --git a/src/openjarvis/server/personal_routes.py b/src/openjarvis/server/personal_routes.py
new file mode 100644
index 00000000..60c8597f
--- /dev/null
+++ b/src/openjarvis/server/personal_routes.py
@@ -0,0 +1,308 @@
+"""FastAPI routes backing the personal dashboard page."""
+
+from __future__ import annotations
+
+import asyncio
+from dataclasses import asdict
+from typing import List
+
+from fastapi import APIRouter, HTTPException, Request
+from fastapi.responses import FileResponse
+from pydantic import BaseModel
+
+from openjarvis.personal.store import (
+    PersonalStore,
+    load_preferences,
+    load_settings,
+    load_whitelist,
+    now_local,
+    personal_dir,
+    save_preferences,
+    save_settings,
+    save_whitelist,
+)
+
+_BG_TYPES = {"image/png": "png", "image/jpeg": "jpg", "image/webp": "webp",
+             "image/gif": "gif"}
+_BG_MAX_BYTES = 15 * 1024 * 1024
+
+
+def _background_file():
+    return next((personal_dir() / "theme").glob("background.*"), None)
+
+
+class Whitelist(BaseModel):
+    """Event Mate whitelist: an email passes if either list matches."""
+
+    sender_domains: List[str]
+    keywords: List[str]
+
+
+class EmailRef(BaseModel):
+    doc_id: str
+
+
+class EmailAccount(BaseModel):
+    email: str
+    app_password: str
+
+
+class TextBody(BaseModel):
+    text: str
+
+
+def create_personal_router() -> APIRouter:
+    router = APIRouter(prefix="/api/personal", tags=["personal"])
+
+    @router.get("/dashboard")
+    async def get_dashboard(deadline_days: int = 30, email_days: int = 7):
+        """Important emails, deadlines, to-dos, events and job leads in one payload."""
+        from openjarvis.personal import todo
+
+        with PersonalStore() as store:
+            data = store.dashboard(deadline_days=deadline_days,
+                                   email_days=email_days)
+        items = todo.read_todos(load_settings()["todo_files"])
+        items += [{"text": d["what"], "due": d["due_date"], "time": "",
+                   "today": False, "source": "Deadline", "url": d["ref"]}
+                  for d in data["deadlines"]]
+        data["todo"] = todo.bucket(items, now_local().date())
+        return data
+
+    @router.get("/emails")
+    async def list_emails(account: str = "", q: str = "", offset: int = 0, limit: int = 50):
+        """Every stored inbox email (spam is never synced), newest first."""
+        from openjarvis.personal import inbox
+
+        return await asyncio.to_thread(inbox.list_emails, account, q, offset, limit)
+
+    @router.get("/emails/message")
+    async def get_email(id: str):
+        from openjarvis.personal.eventmate import load_email
+
+        email = await asyncio.to_thread(load_email, id)
+        if email is None:
+            raise HTTPException(status_code=404, detail="Email not found")
+        return asdict(email)
+
+    @router.post("/emails/dismiss")
+    async def dismiss_email(body: EmailRef):
+        with PersonalStore() as store:
+            if not store.dismiss_email(body.doc_id):
+                raise HTTPException(status_code=404, detail="Email not found")
+        return {"ok": True}
+
+    @router.get("/jobs")
+    async def list_jobs():
+        with PersonalStore() as store:
+            return {"jobs": store.list_jobs()}
+
+    def _job_detail(job_id: int) -> dict:
+        from openjarvis.personal.jobs import RESUME_FOCUSES, read_drafts
+
+        with PersonalStore() as store:
+            job = store.get_job(job_id)
+        if job is None:
+            raise HTTPException(status_code=404, detail="Job not found")
+        focus = job["resume_focus"] if job["resume_focus"] in RESUME_FOCUSES else "business"
+        job["base_resume"] = RESUME_FOCUSES[focus]
+        job.update(read_drafts(job["resume_draft"]) if job["resume_draft"]
+                   else {"resume": "", "cover_letter": ""})
+        return job
+
+    @router.get("/jobs/{job_id}")
+    async def get_job(job_id: int):
+        return _job_detail(job_id)
+
+    @router.post("/jobs/{job_id}/drafts")
+    async def draft_job(job_id: int):
+        """Write a tailored resume and cover letter now (takes about a minute)."""
+        from openjarvis.personal.jobs import draft_job as _draft
+
+        _job_detail(job_id)  # 404 before spending model time
+        await asyncio.to_thread(_draft, job_id)
+        return _job_detail(job_id)
+
+    @router.post("/jobs/{job_id}/apply")
+    async def open_application(job_id: int):
+        """Open the application in a visible browser and fill it in; the user submits."""
+        import subprocess
+        import sys
+        from pathlib import Path
+
+        _job_detail(job_id)
+        exe = Path(sys.executable)
+        pythonw = exe.with_name("pythonw.exe")
+        subprocess.Popen([str(pythonw if pythonw.exists() else exe),
+                          "-m", "openjarvis.personal.apply", str(job_id)],
+                         creationflags=getattr(subprocess, "DETACHED_PROCESS", 0))
+        return {"ok": True}
+
+    @router.post("/jobs/{job_id}/dismiss")
+    async def dismiss_job(job_id: int):
+        _job_detail(job_id)
+        with PersonalStore() as store:
+            store.update_job(job_id, status="dismissed")
+        return {"ok": True}
+
+    @router.get("/events")
+    async def list_events():
+        with PersonalStore() as store:
+            return {"events": store.list_events()}
+
+    @router.get("/events/{event_id}")
+    async def get_event(event_id: int):
+        from openjarvis.personal.eventmate import load_email
+
+        with PersonalStore() as store:
+            event = store.get_event(event_id)
+        if event is None:
+            raise HTTPException(status_code=404, detail="Event not found")
+        email = load_email(event["source_doc_id"]) if event["source_doc_id"] else None
+        event["email"] = asdict(email) if email else None
+        return event
+
+    @router.post("/events/{event_id}/dismiss")
+    async def dismiss_event(event_id: int):
+        with PersonalStore() as store:
+            if store.get_event(event_id) is None:
+                raise HTTPException(status_code=404, detail="Event not found")
+            store.update_event(event_id, status="Rejected")
+        return {"ok": True}
+
+    @router.get("/theme/background")
+    async def get_background():
+        path = _background_file()
+        if path is None:
+            raise HTTPException(status_code=404, detail="No background set")
+        return FileResponse(path, headers={"Cache-Control": "no-cache"})
+
+    @router.put("/theme/background")
+    async def put_background(request: Request):
+        kind = request.headers.get("content-type", "").split(";")[0].strip().lower()
+        if kind not in _BG_TYPES:
+            raise HTTPException(status_code=415, detail="Use a PNG, JPEG, WebP or GIF image")
+        data = await request.body()
+        if not data or len(data) > _BG_MAX_BYTES:
+            raise HTTPException(status_code=413, detail="Image must be under 15 MB")
+        folder = personal_dir() / "theme"
+        folder.mkdir(exist_ok=True)
+        for old in folder.glob("background.*"):
+            old.unlink()
+        (folder / f"background.{_BG_TYPES[kind]}").write_bytes(data)
+        return {"ok": True}
+
+    @router.delete("/theme/background")
+    async def delete_background():
+        path = _background_file()
+        if path is not None:
+            path.unlink()
+        return {"ok": True}
+
+    @router.get("/whitelist")
+    async def get_whitelist():
+        return load_whitelist()
+
+    @router.put("/whitelist")
+    async def put_whitelist(body: Whitelist):
+        save_whitelist(body.model_dump())
+        return load_whitelist()
+
+    _AGENTS = ("eventmate", "jobs")
+
+    @router.get("/agents")
+    async def agent_status():
+        """Last run of each agent, as recorded by the agents themselves."""
+        with PersonalStore() as store:
+            runs = {r["agent"]: r for r in store.dashboard()["runs"]}
+        return {"agents": [dict(runs.get(a, {}), agent=a) for a in _AGENTS]}
+
+    @router.post("/agents/{agent}/run")
+    async def run_agent(agent: str):
+        """Start an agent in the background, the same way the scheduled task does."""
+        import subprocess
+        import sys
+        from pathlib import Path
+
+        if agent not in _AGENTS:
+            raise HTTPException(status_code=404, detail="Unknown agent")
+        exe = Path(sys.executable)
+        pythonw = exe.with_name("pythonw.exe")
+        subprocess.Popen([str(pythonw if pythonw.exists() else exe),
+                          "-m", "openjarvis.personal.runner", agent],
+                         creationflags=getattr(subprocess, "DETACHED_PROCESS", 0),
+                         start_new_session=True)
+        return {"ok": True}
+
+    @router.get("/settings")
+    async def get_settings():
+        return load_settings()
+
+    @router.put("/settings")
+    async def put_settings(body: dict):
+        return save_settings(body)
+
+    @router.get("/resumes")
+    async def get_resumes():
+        from openjarvis.personal.jobs import RESUME_FOCUSES, read_resume
+
+        return {"resumes": [{"focus": f, "label": label, "text": read_resume(f)}
+                            for f, label in RESUME_FOCUSES.items()]}
+
+    @router.put("/resumes/{focus}")
+    async def put_resume(focus: str, body: TextBody):
+        from openjarvis.personal.jobs import RESUME_FOCUSES, save_resume
+
+        if focus not in RESUME_FOCUSES:
+            raise HTTPException(status_code=404, detail="Unknown resume")
+        save_resume(focus, body.text)
+        return {"ok": True}
+
+    @router.get("/event-preferences")
+    async def get_event_preferences():
+        return {"text": load_preferences()}
+
+    @router.put("/event-preferences")
+    async def put_event_preferences(body: TextBody):
+        save_preferences(body.text)
+        return {"text": load_preferences()}
+
+    def _email_accounts() -> list[dict]:
+        from openjarvis.connectors.gmail_imap import GmailIMAPConnector
+
+        # Passwords stay on disk; only the address and server are returned.
+        return [{"email": str(a.get("email", "")), "imap_host": str(a.get("imap_host", ""))}
+                for a in GmailIMAPConnector()._load_accounts()]
+
+    @router.get("/email-accounts")
+    async def list_email_accounts():
+        return {"accounts": _email_accounts()}
+
+    @router.post("/email-accounts")
+    async def add_email_account(body: EmailAccount):
+        from openjarvis.connectors.gmail_imap import GmailIMAPConnector
+
+        try:
+            # Logs in to IMAP before saving, so a wrong password never gets stored.
+            await asyncio.to_thread(
+                GmailIMAPConnector().connect_with_credentials,
+                body.email, body.app_password.replace(" ", ""),
+            )
+        except Exception as exc:  # noqa: BLE001 - shown to the user as-is
+            msg = str(exc)
+            if "AUTHENTICATIONFAILED" in msg or "Invalid credentials" in msg:
+                msg = ("Gmail rejected the login. Use a 16-character app password, "
+                       "not your normal password, and check 2-Step Verification is on.")
+            raise HTTPException(status_code=400, detail=msg) from exc
+        return {"accounts": _email_accounts()}
+
+    @router.delete("/email-accounts")
+    async def remove_email_account(email: str):
+        from openjarvis.connectors.gmail_imap import GmailIMAPConnector
+
+        if not any(a["email"].lower() == email.lower() for a in _email_accounts()):
+            raise HTTPException(status_code=404, detail=f"{email} is not connected")
+        GmailIMAPConnector().disconnect(email)
+        return {"accounts": _email_accounts()}
+
+    return router
