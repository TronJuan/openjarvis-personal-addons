index 00000000..3de924a9
--- /dev/null
+++ b/src/openjarvis/cli/personal_cmd.py
@@ -0,0 +1,99 @@
+"""``jarvis personal`` — run Event Mate, the job search, and inspect results."""
+
+from __future__ import annotations
+
+import json
+import logging
+
+import click
+
+
+def _setup_logging(verbose: bool) -> None:
+    logging.basicConfig(
+        level=logging.INFO if verbose else logging.WARNING,
+        format="%(asctime)s %(levelname)s %(name)s: %(message)s",
+    )
+    logging.getLogger("httpx").setLevel(logging.WARNING)
+
+
+@click.group()
+def personal() -> None:
+    """Personal agents: Event Mate, inbox triage, and the daily job search."""
+
+
+@personal.command("eventmate")
+@click.option("--no-sync", is_flag=True, help="Skip the Gmail sync; use stored mail.")
+@click.option("--lookback", default=3, show_default=True,
+              help="Days of mail to consider (already-processed mail is skipped).")
+@click.option("--limit", type=int, default=None, help="Process at most N emails.")
+@click.option("-v", "--verbose", is_flag=True)
+def eventmate_cmd(no_sync: bool, lookback: int, limit: int | None,
+                  verbose: bool) -> None:
+    """Sync new Gmail, flag important mail and deadlines, find events."""
+    from openjarvis.personal import eventmate
+
+    _setup_logging(verbose)
+    if eventmate.is_running():
+        click.echo("Event Mate is already running; skipping this run.")
+        return
+    stats = eventmate.run(sync=not no_sync, sync_days=max(2, min(lookback, 7)),
+                          lookback_days=lookback, limit=limit)
+    click.echo(json.dumps(stats))
+
+
+@personal.command("jobs")
+@click.option("--max-drafts", type=int, default=None,
+              help="Override how many resume/cover letter drafts to write.")
+@click.option("-v", "--verbose", is_flag=True)
+def jobs_cmd(max_drafts: int | None, verbose: bool) -> None:
+    """Search for internships and jobs, score fit, draft applications."""
+    from openjarvis.personal import jobs
+
+    _setup_logging(verbose)
+    click.echo(json.dumps(jobs.run(max_drafts=max_drafts)))
+
+
+@personal.command("dashboard")
+def dashboard_cmd() -> None:
+    """Print what the dashboard page would show."""
+    from openjarvis.personal.store import PersonalStore
+
+    with PersonalStore() as store:
+        data = store.dashboard()
+    click.echo(f"Important emails ({len(data['important_emails'])})")
+    for e in data["important_emails"][:15]:
+        click.echo(f"  [{e['account']}] {e['subject'][:70]} — {e['why'][:80]}")
+    click.echo(f"\nDeadlines ({len(data['deadlines'])})")
+    for d in data["deadlines"]:
+        click.echo(f"  {d['due_date']}  {d['what'][:80]}  ({d['source']})")
+    click.echo(f"\nEvents ({len(data['events'])})")
+    for ev in data["events"][:15]:
+        score = "--" if ev["score"] is None else ev["score"]
+        click.echo(f"  {score:>3}  {ev['date'] or '?':10}  {ev['name'][:60]}"
+                   f"  [{ev['status']}]")
+    click.echo(f"\nJob leads ({len(data['jobs'])})")
+    for j in data["jobs"][:20]:
+        fit = "--" if j["fit"] is None else j["fit"]
+        drafts = " +drafts" if j["resume_draft"] else ""
+        click.echo(f"  {fit:>3}  {j['title'][:55]} — {j['company'][:30]}"
+                   f" ({j['search_category']}){drafts}")
+
+
+@personal.command("whitelist")
+@click.option("--add-domain", multiple=True)
+@click.option("--remove-domain", multiple=True)
+@click.option("--add-keyword", multiple=True)
+@click.option("--remove-keyword", multiple=True)
+def whitelist_cmd(add_domain, remove_domain, add_keyword, remove_keyword) -> None:
+    """Show or edit the Event Mate sender-domain and keyword whitelist."""
+    from openjarvis.personal.store import load_whitelist, save_whitelist
+
+    wl = load_whitelist()
+    if add_domain or remove_domain or add_keyword or remove_keyword:
+        wl["sender_domains"] = [d for d in wl["sender_domains"]
+                                if d not in remove_domain] + list(add_domain)
+        wl["keywords"] = [k for k in wl["keywords"]
+                          if k not in remove_keyword] + list(add_keyword)
+        save_whitelist(wl)
+        wl = load_whitelist()
+    click.echo(json.dumps(wl, indent=2))
