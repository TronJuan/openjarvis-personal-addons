+"""To-do parsing and bucketing for the dashboard (no model or network calls)."""
+
+from __future__ import annotations
+
+from datetime import date
+
+from openjarvis.personal import todo
+
+TODAY = date(2026, 9, 25)
+
+
+def test_parse_line_strips_markers_and_links():
+    assert todo.parse_line("- [ ] FIT2002 A1.2 📅 2026-09-28 ⏰ 23:55") == {
+        "text": "FIT2002 A1.2", "due": "2026-09-28", "time": "23:55", "today": False}
+    item = todo.parse_line("- [ ] Analyse tool — see [[Crack Analysis|the project]]")
+    assert item["text"] == "Analyse tool — see the project" and item["due"] == ""
+    assert todo.parse_line("- [ ] Draft lab writeup #today")["today"] is True
+    assert todo.parse_line("- [x] Done already 📅 2026-09-20") is None
+    assert todo.parse_line("Some prose line") is None
+    assert todo.parse_line("- [ ] 📅 2026-09-28") is None
+
+
+def test_read_todos_skips_missing_files(tmp_path):
+    f = tmp_path / "Reminders.md"
+    f.write_text("# Reminders\n- [ ] A 📅 2026-09-25\n- [x] B\n", encoding="utf-8")
+    items = todo.read_todos([str(f), str(tmp_path / "missing.md")])
+    assert [(i["text"], i["source"]) for i in items] == [("A", "Reminders")]
+
+
+def _item(text, due="", time="", today=False):
+    return {"text": text, "due": due, "time": time, "today": today}
+
+
+def test_bucket():
+    items = [
+        _item("later", "2026-10-09"),
+        _item("overdue", "2026-09-20"),
+        _item("tonight", "2026-09-25", "23:55"),
+        _item("morning", "2026-09-25", "09:45"),
+        _item("in three days", "2026-09-28"),
+        _item("in four days", "2026-09-29"),
+        _item("undated"),
+        _item("tagged today", today=True),
+    ]
+    b = todo.bucket(items, TODAY)
+    assert [i["text"] for i in b["urgent"]] == ["overdue", "in three days"]
+    assert [i["text"] for i in b["today"]] == ["morning", "tonight", "tagged today"]
+    assert [i["text"] for i in b["upcoming"]] == ["in four days", "later", "undated"]
