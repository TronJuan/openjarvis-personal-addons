+"""Settings page email accounts: list, add (login checked first) and remove."""
+
+from __future__ import annotations
+
+import imaplib
+import json
+
+import pytest
+from fastapi import FastAPI
+from fastapi.testclient import TestClient
+
+from openjarvis.connectors import gmail_imap
+from openjarvis.connectors.gmail_imap import GmailIMAPConnector
+from openjarvis.server.personal_routes import create_personal_router
+
+
+@pytest.fixture
+def creds(tmp_path, monkeypatch):
+    path = tmp_path / "gmail_imap.json"
+    monkeypatch.setattr(gmail_imap, "_DEFAULT_CREDENTIALS_PATH", str(path))
+    logins = []
+
+    def fake_login(self, email, password, host, port, security):
+        logins.append((email, password, host))
+        if password != "goodpassword1234":
+            raise imaplib.IMAP4.error("[AUTHENTICATIONFAILED] Invalid credentials (Failure)")
+        return object()
+
+    monkeypatch.setattr(GmailIMAPConnector, "_open_authenticated_imap", fake_login)
+    monkeypatch.setattr(GmailIMAPConnector, "_close_imap", staticmethod(lambda imap: None))
+    return path, logins
+
+
+@pytest.fixture
+def client(creds):
+    app = FastAPI()
+    app.include_router(create_personal_router())
+    return TestClient(app)
+
+
+def test_starts_empty(client):
+    assert client.get("/api/personal/email-accounts").json() == {"accounts": []}
+
+
+def test_add_checks_login_then_saves_without_returning_password(client, creds):
+    path, logins = creds
+    r = client.post("/api/personal/email-accounts",
+                    json={"email": "a@gmail.com", "app_password": "good password 1234"})
+    assert r.status_code == 200
+    assert r.json() == {"accounts": [{"email": "a@gmail.com", "imap_host": "imap.gmail.com"}]}
+    assert logins == [("a@gmail.com", "goodpassword1234", "imap.gmail.com")]
+    assert "password" not in r.text
+    stored = json.loads(path.read_text())["accounts"]
+    assert stored[0]["password"] == "goodpassword1234"
+
+
+def test_wrong_password_is_rejected_and_not_saved(client, creds):
+    path, _ = creds
+    r = client.post("/api/personal/email-accounts",
+                    json={"email": "a@gmail.com", "app_password": "nope"})
+    assert r.status_code == 400
+    assert "app password" in r.json()["detail"]
+    assert not path.exists()
+
+
+def test_second_account_is_added_and_one_can_be_removed(client):
+    for address in ("a@gmail.com", "b@gmail.com"):
+        client.post("/api/personal/email-accounts",
+                    json={"email": address, "app_password": "goodpassword1234"})
+    listed = client.get("/api/personal/email-accounts").json()["accounts"]
+    assert [a["email"] for a in listed] == ["a@gmail.com", "b@gmail.com"]
+
+    r = client.delete("/api/personal/email-accounts", params={"email": "A@gmail.com"})
+    assert [a["email"] for a in r.json()["accounts"]] == ["b@gmail.com"]
+
+
+def test_removing_unknown_account_is_404(client):
+    r = client.delete("/api/personal/email-accounts", params={"email": "x@gmail.com"})
+    assert r.status_code == 404
