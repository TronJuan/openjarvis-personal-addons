+"""Emails page backend: every stored inbox email across accounts, and the routes."""
+
+from __future__ import annotations
+
+import json
+import sqlite3
+
+import pytest
+from fastapi import FastAPI
+from fastapi.testclient import TestClient
+
+from openjarvis.personal import inbox
+from openjarvis.server.personal_routes import create_personal_router
+
+
+def _add(conn, account, msg_id, subject, sender, timestamp, chunks=("Body text",)):
+    meta = json.dumps({"account": account, "message_id": msg_id})
+    for i, content in enumerate(chunks):
+        conn.execute(
+            "INSERT INTO knowledge_chunks VALUES (?,?,?,?,?,?,?,?,?,?,NULL)",
+            (f"gmail:{account}:{msg_id}", i, "gmail", "email", subject, sender,
+             timestamp, "", meta, content))
+
+
+@pytest.fixture
+def home(tmp_path, monkeypatch):
+    monkeypatch.setenv("OPENJARVIS_HOME", str(tmp_path))
+    monkeypatch.setitem(inbox._cache, "key", None)
+    conn = sqlite3.connect(tmp_path / "knowledge.db")
+    conn.execute(
+        "CREATE TABLE knowledge_chunks (doc_id TEXT, chunk_index INTEGER,"
+        " source TEXT, doc_type TEXT, title TEXT, author TEXT, timestamp TEXT,"
+        " url TEXT, metadata TEXT, content TEXT, deleted_at REAL)")
+    _add(conn, "a@gmail.com", "<1@x>", "Old news", "Bob <b@x.com>", "2025-01-01T10:00:00+00:00")
+    # 09:00 in Melbourne is 23:00 UTC the day before, so this is older than <3@x>.
+    _add(conn, "b@example.edu", "<2@x>", "Exam timetable", "Uni <m@example.edu>",
+         "2026-09-25T09:00:00+10:00", chunks=("Your exams are in November.", "Second chunk"))
+    _add(conn, "a@gmail.com", "<3@x>", "Invoice", "Shop <s@shop.com>", "2026-09-25T01:00:00+00:00")
+    conn.commit()
+    conn.close()
+    return tmp_path
+
+
+def test_newest_first_across_accounts_with_counts(home):
+    data = inbox.list_emails()
+    assert [e["subject"] for e in data["emails"]] == ["Invoice", "Exam timetable", "Old news"]
+    assert data["total"] == 3
+    assert data["accounts"] == [{"account": "a@gmail.com", "count": 2},
+                                {"account": "b@example.edu", "count": 1}]
+    exam = data["emails"][1]
+    assert exam["snippet"] == "Your exams are in November."
+    assert "authuser=b@example.edu" in exam["url"]
+
+
+def test_filter_search_and_paging(home):
+    assert [e["subject"] for e in inbox.list_emails(account="a@gmail.com")["emails"]] == [
+        "Invoice", "Old news"]
+    assert [e["subject"] for e in inbox.list_emails(q="uni november")["emails"]] == [
+        "Exam timetable"]
+    page = inbox.list_emails(offset=1, limit=1)
+    assert page["total"] == 3 and [e["subject"] for e in page["emails"]] == ["Exam timetable"]
+
+
+def test_cache_reloads_when_mail_arrives(home):
+    assert inbox.list_emails()["total"] == 3
+    conn = sqlite3.connect(home / "knowledge.db")
+    _add(conn, "a@gmail.com", "<4@x>", "Brand new", "C <c@x.com>", "2026-09-26T00:00:00+00:00")
+    conn.commit()
+    conn.close()
+    assert inbox.list_emails()["emails"][0]["subject"] == "Brand new"
+
+
+def test_email_routes(home):
+    app = FastAPI()
+    app.include_router(create_personal_router())
+    client = TestClient(app)
+    listed = client.get("/api/personal/emails", params={"account": "b@example.edu"}).json()
+    assert [e["subject"] for e in listed["emails"]] == ["Exam timetable"]
+    doc_id = listed["emails"][0]["doc_id"]
+    full = client.get("/api/personal/emails/message", params={"id": doc_id}).json()
+    assert full["body"].startswith("Your exams are in November.")
+    assert full["account"] == "b@example.edu"
+    assert client.get("/api/personal/emails/message", params={"id": "gmail:nope"}).status_code == 404
+
+
+def test_snippet_strips_html_and_outlook_css():
+    raw = ('<!--[if gte mso 9]><style>.x { display: block; }</style><![endif]-->'
+           '<html><style>td { padding: 0 }</style><p>Hi Alex &amp; team,</p><p>See you</p></html>')
+    assert inbox._snippet(raw) == "Hi Alex & team, See you"
+    assert inbox._snippet('<p>Dear member,</p> <td style="text-al') == "Dear member,"
+    assert inbox._snippet('<p>Your code</p><style>table td { border-collapse: coll') == "Your code"
