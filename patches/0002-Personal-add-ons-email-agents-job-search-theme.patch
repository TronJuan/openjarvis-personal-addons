+++ b/src/openjarvis/personal/store.py
@@ -0,0 +1,476 @@
+"""SQLite store and user-editable settings for the personal agents."""
+
+from __future__ import annotations
+
+import json
+import re
+import sqlite3
+import time
+from datetime import datetime
+from pathlib import Path
+from typing import Any
+from zoneinfo import ZoneInfo
+
+from openjarvis.core.paths import get_config_dir
+
+
+_SCHEMA = """
+CREATE TABLE IF NOT EXISTS emails_seen (
+    doc_id       TEXT PRIMARY KEY,
+    account      TEXT NOT NULL DEFAULT '',
+    received_at  TEXT NOT NULL DEFAULT '',
+    whitelisted  INTEGER NOT NULL DEFAULT 0,
+    important    INTEGER NOT NULL DEFAULT 0,
+    category     TEXT NOT NULL DEFAULT '',
+    processed_at REAL NOT NULL
+);
+CREATE TABLE IF NOT EXISTS important_emails (
+    doc_id      TEXT PRIMARY KEY,
+    account     TEXT NOT NULL DEFAULT '',
+    sender      TEXT NOT NULL DEFAULT '',
+    subject     TEXT NOT NULL DEFAULT '',
+    received_at TEXT NOT NULL DEFAULT '',
+    why         TEXT NOT NULL DEFAULT '',
+    url         TEXT NOT NULL DEFAULT '',
+    dismissed   INTEGER NOT NULL DEFAULT 0
+);
+CREATE TABLE IF NOT EXISTS deadlines (
+    id         INTEGER PRIMARY KEY AUTOINCREMENT,
+    due_date   TEXT NOT NULL,
+    what       TEXT NOT NULL,
+    source     TEXT NOT NULL,
+    ref        TEXT NOT NULL DEFAULT '',
+    account    TEXT NOT NULL DEFAULT '',
+    dismissed  INTEGER NOT NULL DEFAULT 0,
+    created_at REAL NOT NULL,
+    UNIQUE (source, ref, due_date)
+);
+CREATE TABLE IF NOT EXISTS events (
+    id                INTEGER PRIMARY KEY AUTOINCREMENT,
+    event_key         TEXT NOT NULL UNIQUE,
+    name              TEXT NOT NULL,
+    organisation      TEXT NOT NULL DEFAULT '',
+    date              TEXT NOT NULL DEFAULT '',
+    start_time        TEXT NOT NULL DEFAULT '',
+    end_time          TEXT NOT NULL DEFAULT '',
+    location          TEXT NOT NULL DEFAULT '',
+    category          TEXT NOT NULL DEFAULT '',
+    description       TEXT NOT NULL DEFAULT '',
+    registration_link TEXT NOT NULL DEFAULT '',
+    cost              TEXT NOT NULL DEFAULT '',
+    source_doc_id     TEXT NOT NULL DEFAULT '',
+    account           TEXT NOT NULL DEFAULT '',
+    status            TEXT NOT NULL DEFAULT 'New',
+    availability      TEXT NOT NULL DEFAULT 'Not checked',
+    score             INTEGER,
+    recommendation    TEXT NOT NULL DEFAULT '',
+    why               TEXT NOT NULL DEFAULT '',
+    created_at        REAL NOT NULL,
+    updated_at        REAL NOT NULL
+);
+CREATE TABLE IF NOT EXISTS jobs (
+    id                 INTEGER PRIMARY KEY AUTOINCREMENT,
+    url                TEXT NOT NULL UNIQUE,
+    title              TEXT NOT NULL DEFAULT '',
+    company            TEXT NOT NULL DEFAULT '',
+    location           TEXT NOT NULL DEFAULT '',
+    job_type           TEXT NOT NULL DEFAULT '',
+    search_category    TEXT NOT NULL DEFAULT '',
+    kind               TEXT NOT NULL DEFAULT '',
+    closing_date       TEXT NOT NULL DEFAULT '',
+    fit                INTEGER,
+    why                TEXT NOT NULL DEFAULT '',
+    needs_cover_letter INTEGER NOT NULL DEFAULT 0,
+    resume_focus       TEXT NOT NULL DEFAULT '',
+    resume_draft       TEXT NOT NULL DEFAULT '',
+    cover_letter_draft TEXT NOT NULL DEFAULT '',
+    status             TEXT NOT NULL DEFAULT 'new',
+    found_at           REAL NOT NULL
+);
+CREATE TABLE IF NOT EXISTS runs (
+    agent         TEXT PRIMARY KEY,
+    last_started  REAL,
+    last_finished REAL,
+    last_status   TEXT NOT NULL DEFAULT '',
+    detail        TEXT NOT NULL DEFAULT ''
+);
+"""
+
+
+def personal_dir() -> Path:
+    path = get_config_dir() / "personal"
+    path.mkdir(parents=True, exist_ok=True)
+    return path
+
+
+def db_path() -> Path:
+    return get_config_dir() / "personal.db"
+
+
+def now_local() -> datetime:
+    return datetime.now().astimezone()
+
+
+def event_key(name: str, organisation: str, date: str) -> str:
+    norm = lambda s: re.sub(r"[^a-z0-9]+", " ", (s or "").lower()).strip()  # noqa: E731
+    return f"{norm(name)}|{norm(organisation)}|{date or ''}"
+
+
+class PersonalStore:
+    """Thin wrapper over ``personal.db``; one connection per instance."""
+
+    def __init__(self, path: Path | None = None) -> None:
+        self._conn = sqlite3.connect(str(path or db_path()), timeout=30)
+        self._conn.row_factory = sqlite3.Row
+        self._conn.execute("PRAGMA journal_mode=WAL")
+        self._conn.executescript(_SCHEMA)
+        # Columns added after the first release; older databases gain them here.
+        cols = {r[1] for r in self._conn.execute("PRAGMA table_info(jobs)")}
+        for name in ("description", "region", "work_period"):
+            if name not in cols:
+                self._conn.execute(
+                    f"ALTER TABLE jobs ADD COLUMN {name} TEXT NOT NULL DEFAULT ''")
+        self._conn.commit()
+
+    def close(self) -> None:
+        self._conn.close()
+
+    def __enter__(self) -> "PersonalStore":
+        return self
+
+    def __exit__(self, *exc: Any) -> None:
+        self.close()
+
+    # -- emails ---------------------------------------------------------------
+
+    def seen_doc_ids(self) -> set[str]:
+        return {r[0] for r in self._conn.execute("SELECT doc_id FROM emails_seen")}
+
+    def mark_seen(self, doc_id: str, account: str, received_at: str, *,
+                  whitelisted: bool, important: bool, category: str) -> None:
+        self._conn.execute(
+            "INSERT OR REPLACE INTO emails_seen VALUES (?,?,?,?,?,?,?)",
+            (doc_id, account, received_at, int(whitelisted), int(important),
+             category, time.time()),
+        )
+        self._conn.commit()
+
+    def add_important_email(self, **row: Any) -> None:
+        self._conn.execute(
+            "INSERT OR REPLACE INTO important_emails"
+            " (doc_id, account, sender, subject, received_at, why, url)"
+            " VALUES (:doc_id,:account,:sender,:subject,:received_at,:why,:url)",
+            row,
+        )
+        self._conn.commit()
+
+    def dismiss_email(self, doc_id: str) -> bool:
+        cur = self._conn.execute(
+            "UPDATE important_emails SET dismissed = 1 WHERE doc_id = ?", (doc_id,))
+        self._conn.commit()
+        return cur.rowcount > 0
+
+    def add_deadline(self, due_date: str, what: str, source: str,
+                     ref: str = "", account: str = "") -> None:
+        self._conn.execute(
+            "INSERT OR IGNORE INTO deadlines"
+            " (due_date, what, source, ref, account, created_at)"
+            " VALUES (?,?,?,?,?,?)",
+            (due_date, what, source, ref, account, time.time()),
+        )
+        self._conn.commit()
+
+    # -- events ---------------------------------------------------------------
+
+    def find_event(self, key: str) -> sqlite3.Row | None:
+        return self._conn.execute(
+            "SELECT * FROM events WHERE event_key = ?", (key,)
+        ).fetchone()
+
+    def find_event_by_name(self, name: str) -> sqlite3.Row | None:
+        return self._conn.execute(
+            "SELECT * FROM events WHERE lower(name) = lower(?)"
+            " ORDER BY updated_at DESC LIMIT 1",
+            (name.strip(),),
+        ).fetchone()
+
+    def upsert_event(self, fields: dict[str, Any]) -> int:
+        now = time.time()
+        key = event_key(fields["name"], fields.get("organisation", ""),
+                        fields.get("date", ""))
+        existing = self.find_event(key)
+        if existing is None:
+            cols = dict(fields, event_key=key, created_at=now, updated_at=now)
+            names = ",".join(cols)
+            marks = ",".join(f":{c}" for c in cols)
+            cur = self._conn.execute(
+                f"INSERT INTO events ({names}) VALUES ({marks})", cols
+            )
+            self._conn.commit()
+            return int(cur.lastrowid)
+        # Only fill blanks; never overwrite values a previous run or the user set.
+        updates = {k: v for k, v in fields.items()
+                   if v not in ("", None) and not existing[k]}
+        if updates:
+            sets = ",".join(f"{k} = :{k}" for k in updates)
+            self._conn.execute(
+                f"UPDATE events SET {sets}, updated_at = :now WHERE id = :id",
+                dict(updates, now=now, id=existing["id"]),
+            )
+            self._conn.commit()
+        return int(existing["id"])
+
+    def update_event(self, event_id: int, **fields: Any) -> None:
+        sets = ",".join(f"{k} = :{k}" for k in fields)
+        self._conn.execute(
+            f"UPDATE events SET {sets}, updated_at = :now WHERE id = :id",
+            dict(fields, now=time.time(), id=event_id),
+        )
+        self._conn.commit()
+
+    def unscored_events(self) -> list[sqlite3.Row]:
+        return list(self._conn.execute(
+            "SELECT * FROM events WHERE score IS NULL AND status != 'Rejected'"
+        ))
+
+    def list_events(self) -> list[dict]:
+        """Events that are not hidden and not over, best match first."""
+        return [dict(r) for r in self._conn.execute(
+            "SELECT * FROM events WHERE status != 'Rejected'"
+            " AND (date = '' OR date >= ?)"
+            " ORDER BY (score IS NULL), score DESC, date",
+            (now_local().date().isoformat(),))]
+
+    def get_event(self, event_id: int) -> dict | None:
+        row = self._conn.execute("SELECT * FROM events WHERE id = ?",
+                                 (event_id,)).fetchone()
+        return dict(row) if row else None
+
+    # -- jobs -----------------------------------------------------------------
+
+    def list_jobs(self) -> list[dict]:
+        """Postings for the Jobs page, best fit first (no long text fields)."""
+        return [dict(r) for r in self._conn.execute(
+            "SELECT id, url, title, company, location, region, job_type,"
+            " search_category, closing_date, work_period, fit, why,"
+            " needs_cover_letter, resume_focus, status, found_at,"
+            " resume_draft != '' AS has_drafts,"
+            " substr(description, 1, 240) AS preview"
+            " FROM jobs WHERE kind = 'posting' AND status != 'dismissed'"
+            " ORDER BY fit DESC, found_at DESC")]
+
+    def get_job(self, job_id: int) -> dict | None:
+        row = self._conn.execute("SELECT * FROM jobs WHERE id = ?",
+                                 (job_id,)).fetchone()
+        return dict(row) if row else None
+
+    def postings(self) -> list[dict]:
+        return [dict(r) for r in self._conn.execute(
+            "SELECT * FROM jobs WHERE kind = 'posting' AND fit IS NOT NULL")]
+
+    def remove_deadlines(self, source: str, ref: str) -> None:
+        self._conn.execute("DELETE FROM deadlines WHERE source = ? AND ref = ?",
+                           (source, ref))
+        self._conn.commit()
+
+    def job_urls(self) -> set[str]:
+        return {r[0] for r in self._conn.execute("SELECT url FROM jobs")}
+
+    def add_job(self, fields: dict[str, Any]) -> int:
+        cols = dict(fields, found_at=time.time())
+        names = ",".join(cols)
+        marks = ",".join(f":{c}" for c in cols)
+        cur = self._conn.execute(
+            f"INSERT OR IGNORE INTO jobs ({names}) VALUES ({marks})", cols
+        )
+        self._conn.commit()
+        return int(cur.lastrowid)
+
+    def update_job(self, job_id: int, **fields: Any) -> None:
+        sets = ",".join(f"{k} = :{k}" for k in fields)
+        self._conn.execute(f"UPDATE jobs SET {sets} WHERE id = :id",
+                           dict(fields, id=job_id))
+        self._conn.commit()
+
+    # -- runs -----------------------------------------------------------------
+
+    def run_started(self, agent: str) -> None:
+        self._conn.execute(
+            "INSERT INTO runs (agent, last_started, last_status) VALUES (?,?,?)"
+            " ON CONFLICT(agent) DO UPDATE SET last_started = excluded.last_started,"
+            " last_status = 'running'",
+            (agent, time.time(), "running"),
+        )
+        self._conn.commit()
+
+    def run_finished(self, agent: str, status: str, detail: str = "") -> None:
+        self._conn.execute(
+            "UPDATE runs SET last_finished = ?, last_status = ?, detail = ?"
+            " WHERE agent = ?",
+            (time.time(), status, detail, agent),
+        )
+        self._conn.commit()
+
+    # -- dashboard ------------------------------------------------------------
+
+    def dashboard(self, *, deadline_days: int = 30, email_days: int = 7) -> dict:
+        today = now_local().date().isoformat()
+        # received_at is stored as UTC ISO text, so string comparison is ordering.
+        email_cutoff = datetime.fromtimestamp(
+            time.time() - email_days * 86400, ZoneInfo("UTC")
+        ).isoformat()
+        rows = lambda sql, *a: [dict(r) for r in self._conn.execute(sql, a)]  # noqa: E731
+        return {
+            "generated_at": now_local().isoformat(),
+            "important_emails": rows(
+                "SELECT * FROM important_emails WHERE dismissed = 0"
+                " AND received_at >= ? ORDER BY received_at DESC",
+                email_cutoff,
+            ),
+            "deadlines": rows(
+                "SELECT * FROM deadlines WHERE dismissed = 0 AND due_date >= ?"
+                " AND due_date <= date(?, ?) ORDER BY due_date",
+                today, today, f"+{deadline_days} days",
+            ),
+            "events": self.list_events(),
+            "jobs": rows(
+                "SELECT id, url, title, company, location, job_type,"
+                " search_category, kind, closing_date, fit, why,"
+                " needs_cover_letter, resume_draft, cover_letter_draft, status,"
+                " found_at FROM jobs WHERE status != 'dismissed'"
+                " AND kind = 'posting' AND (closing_date = '' OR closing_date >= ?)"
+                " ORDER BY fit DESC, found_at DESC LIMIT 100",
+                today,
+            ),
+            "runs": rows("SELECT * FROM runs"),
+        }
+
+
+# -- user-editable settings files ---------------------------------------------
+
+DEFAULT_WHITELIST: dict[str, list[str]] = {
+    "sender_domains": [
+        "eventbrite.com",
+        "eventbrite.com.au",
+        "humanitix.com",
+        "meetup.com",
+        "gradconnection.com",
+        "prosple.com",
+        "lu.ma",
+    ],
+    "keywords": [
+        "event", "workshop", "networking", "rsvp", "register", "registration",
+        "hackathon", "case competition", "careers fair", "career fair",
+        "info session", "information session", "webinar", "panel", "meetup",
+        "seminar", "social", "bbq", "tickets", "you're registered",
+        "you are registered", "registration confirmed",
+    ],
+}
+
+
+def load_whitelist() -> dict[str, list[str]]:
+    path = personal_dir() / "eventmate_whitelist.json"
+    if not path.exists():
+        save_whitelist(DEFAULT_WHITELIST)
+        return {k: list(v) for k, v in DEFAULT_WHITELIST.items()}
+    data = json.loads(path.read_text(encoding="utf-8"))
+    return {
+        "sender_domains": [str(d).lower().strip() for d in data.get("sender_domains", [])],
+        "keywords": [str(k).lower().strip() for k in data.get("keywords", [])],
+    }
+
+
+def save_whitelist(data: dict[str, list[str]]) -> None:
+    clean = {
+        "sender_domains": sorted({d.lower().strip().lstrip("@") for d in
+                                  data.get("sender_domains", []) if d.strip()}),
+        "keywords": sorted({k.lower().strip() for k in data.get("keywords", [])
+                            if k.strip()}),
+    }
+    (personal_dir() / "eventmate_whitelist.json").write_text(
+        json.dumps(clean, indent=2), encoding="utf-8"
+    )
+
+
+DEFAULT_PREFERENCES = """# Event preferences
+
+Event Mate scores events against this page. Edit it in Settings.
+
+**Interests:** Technology, AI, Careers
+
+**Event priorities:** Networking, Career development, Workshops, Hackathons, Social events
+
+**Preferences:**
+
+- Prefer free events
+- Prefer weekday evening events
+- Prefer events within 45 minutes of home
+"""
+
+
+def save_preferences(text: str) -> None:
+    (personal_dir() / "event_preferences.md").write_text(text, encoding="utf-8")
+
+
+def load_preferences() -> str:
+    path = personal_dir() / "event_preferences.md"
+    if not path.exists():
+        path.write_text(DEFAULT_PREFERENCES, encoding="utf-8")
+    return path.read_text(encoding="utf-8")
+
+
+DEFAULT_PROFILE: dict[str, str] = {
+    "name": "",
+    "email": "",
+    "phone": "",
+    "linkedin": "",
+    # Facts the job agent may rely on that are not on the resume.
+    "about": "",
+    # Who can apply: graduation date, work rights, locations, study breaks.
+    "eligibility": "",
+    # What counts as a close field match, e.g. "software engineering or data".
+    "target_fields": "",
+    "locations": "",
+}
+
+DEFAULT_SETTINGS: dict[str, Any] = {
+    "profile": DEFAULT_PROFILE,
+    # Postings whose title, period or description contain one of these are
+    # capped at fit 20, e.g. "2026/27" or "security clearance".
+    "exclude_phrases": [],
+    # Drafts that mention one of these are dropped (roles you never list).
+    "never_mention": [],
+    "drafts_dir": "",
+    "todo_files": [],
+    "browser_profile_directory": "Default",
+    "fit_threshold_for_drafts": 75,
+    "max_drafts_per_run": 3,
+    "results_per_search": 6,
+    "roles_per_listing_page": 8,
+    "job_searches": [
+        {"category": "Internship", "query": "software engineering internship 2027 students"},
+        {"category": "Graduate program", "query": "technology graduate program applications open"},
+    ],
+}
+
+
+def load_settings() -> dict[str, Any]:
+    path = personal_dir() / "settings.json"
+    if not path.exists():
+        path.write_text(json.dumps(DEFAULT_SETTINGS, indent=2), encoding="utf-8")
+        return json.loads(json.dumps(DEFAULT_SETTINGS))
+    data = json.loads(path.read_text(encoding="utf-8"))
+    merged = {**DEFAULT_SETTINGS, **data}
+    merged["profile"] = {**DEFAULT_PROFILE, **(data.get("profile") or {})}
+    return merged
+
+
+def save_settings(data: dict[str, Any]) -> dict[str, Any]:
+    """Store the known settings keys; unknown keys are ignored."""
+    current = load_settings()
+    for key in DEFAULT_SETTINGS:
+        if key in data:
+            current[key] = data[key]
+    current["profile"] = {k: str(current["profile"].get(k, "")) for k in DEFAULT_PROFILE}
+    (personal_dir() / "settings.json").write_text(json.dumps(current, indent=2), encoding="utf-8")
+    return current
diff --git a/src/openjarvis/personal/todo.py b/src/openjarvis/personal/todo.py
