+from openjarvis.personal.apply import _value_for, contact_details
+
+RESUME = """## Alex Example
+
+Springfield · +61 400 000 000 · alex@example.com · linkedin.com/in/alex-example
+"""
+
+
+def test_contact_details():
+    d = contact_details(RESUME)
+    assert d["first_name"] == "Alex" and d["last_name"] == "Example"
+    assert d["email"] == "alex@example.com"
+    assert d["phone"] == "+61 400 000 000"
+    assert d["linkedin"] == "https://linkedin.com/in/alex-example"
+
+
+def test_profile_overrides_resume():
+    d = contact_details(RESUME, {"name": "Sam Other", "email": "sam@example.org",
+                                 "phone": "", "linkedin": "linkedin.com/in/sam"})
+    assert (d["first_name"], d["last_name"]) == ("Sam", "Other")
+    assert d["email"] == "sam@example.org"
+    assert d["phone"] == "+61 400 000 000"
+    assert d["linkedin"] == "https://linkedin.com/in/sam"
+
+
+def test_field_matching():
+    d = contact_details(RESUME)
+    assert _value_for("first name", d, "L") == "Alex"
+    assert _value_for("surname", d, "L") == "Example"
+    assert _value_for("mobile phone", d, "L") == "+61 400 000 000"
+    assert _value_for("cover letter", d, "L") == "L"
+    assert _value_for("current company name", d, "L") == ""
+    assert _value_for("username", d, "L") == ""
