index 00000000..4389bc52
--- /dev/null
+++ b/tests/connectors/test_gmail_imap_accounts.py
@@ -0,0 +1,129 @@
+"""Multiple Gmail accounts under the single gmail_imap connector."""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+from unittest.mock import MagicMock, patch
+
+import pytest
+
+from openjarvis.connectors.gmail_imap import GmailIMAPConnector
+from openjarvis.connectors.oauth import load_tokens
+
+
+def _client(message_id: bytes) -> MagicMock:
+    client = MagicMock()
+    client.login.return_value = ("OK", [])
+    client.select.return_value = ("OK", [])
+    client.response.return_value = ("UIDVALIDITY", [b"777"])
+    client.logout.return_value = ("OK", [])
+    raw = (
+        b"From: sender@test.com\r\nTo: me@gmail.com\r\nSubject: Hi\r\n"
+        b"Date: Mon, 01 Jan 2024 00:00:00 +0000\r\n"
+        b"Message-ID: " + message_id + b"\r\n\r\nBody"
+    )
+
+    def uid(command: str, *args):
+        if command == "SEARCH":
+            return "OK", [b"41"]
+        return "OK", [(b"41 (RFC822 {1})", raw)]
+
+    client.uid.side_effect = uid
+    return client
+
+
+def _connect(conn: GmailIMAPConnector, address: str, password: str = "pw") -> None:
+    with patch.object(conn, "_make_imap_client", return_value=_client(b"<x>")):
+        conn.connect_with_credentials(address, password)
+
+
+def test_second_account_is_added_not_overwritten(tmp_path: Path) -> None:
+    path = str(tmp_path / "gmail_imap.json")
+    _connect(GmailIMAPConnector(credentials_path=path), "a@gmail.com")
+    _connect(GmailIMAPConnector(credentials_path=path), "b@gmail.com")
+
+    conn = GmailIMAPConnector(credentials_path=path)
+    assert conn.accounts() == ["a@gmail.com", "b@gmail.com"]
+    assert conn.is_connected()
+
+
+def test_reconnecting_an_account_replaces_it(tmp_path: Path) -> None:
+    path = str(tmp_path / "gmail_imap.json")
+    _connect(GmailIMAPConnector(credentials_path=path), "a@gmail.com", "old")
+    _connect(GmailIMAPConnector(credentials_path=path), "A@gmail.com", "new")
+
+    accounts = load_tokens(path)["accounts"]
+    assert [a["password"] for a in accounts] == ["new"]
+
+
+def test_sync_covers_every_account_and_tags_it(tmp_path: Path) -> None:
+    path = str(tmp_path / "gmail_imap.json")
+    _connect(GmailIMAPConnector(credentials_path=path), "a@gmail.com")
+    _connect(GmailIMAPConnector(credentials_path=path), "b@gmail.com")
+
+    conn = GmailIMAPConnector(credentials_path=path)
+    logins: list[str] = []
+
+    def make_client(*_args):
+        client = _client(b"<same@id>")
+        client.login.side_effect = lambda user, _pw: logins.append(user) or ("OK", [])
+        return client
+
+    with patch.object(conn, "_make_imap_client", side_effect=make_client):
+        docs = list(conn.sync())
+
+    assert logins == ["a@gmail.com", "b@gmail.com"]
+    assert [d.metadata["account"] for d in docs] == ["a@gmail.com", "b@gmail.com"]
+    # The same message in both inboxes must not collapse into one document.
+    assert len({d.doc_id for d in docs}) == 2
+    assert docs[1].doc_id == "gmail:b@gmail.com:<same@id>"
+    assert "authuser=b@gmail.com" in docs[1].url
+    assert conn.sync_status().items_synced == 2
+
+
+def test_failed_account_does_not_stop_the_others(tmp_path: Path) -> None:
+    path = str(tmp_path / "gmail_imap.json")
+    _connect(GmailIMAPConnector(credentials_path=path), "a@gmail.com")
+    _connect(GmailIMAPConnector(credentials_path=path), "b@gmail.com")
+    conn = GmailIMAPConnector(credentials_path=path)
+
+    def make_client(*_args):
+        client = _client(b"<m>")
+        client.login.side_effect = lambda user, _pw: (
+            ("NO", []) if user == "a@gmail.com" else ("OK", [])
+        )
+        return client
+
+    with patch.object(conn, "_make_imap_client", side_effect=make_client):
+        docs = list(conn.sync())
+
+    assert [d.metadata["account"] for d in docs] == ["b@gmail.com"]
+
+
+def test_disconnect_one_account(tmp_path: Path) -> None:
+    path = str(tmp_path / "gmail_imap.json")
+    _connect(GmailIMAPConnector(credentials_path=path), "a@gmail.com")
+    _connect(GmailIMAPConnector(credentials_path=path), "b@gmail.com")
+
+    conn = GmailIMAPConnector(credentials_path=path)
+    conn.disconnect("A@gmail.com")
+    assert conn.accounts() == ["b@gmail.com"]
+    with pytest.raises(ValueError):
+        conn.disconnect("nobody@gmail.com")
+
+
+def test_legacy_single_record_is_read_and_upgraded(tmp_path: Path) -> None:
+    path = tmp_path / "gmail_imap.json"
+    path.write_text(
+        json.dumps({"email": "old@gmail.com", "password": "pw", "validated": True})
+    )
+    conn = GmailIMAPConnector(credentials_path=str(path))
+    assert conn.accounts() == ["old@gmail.com"]
+    assert conn.is_connected()
+
+    _connect(GmailIMAPConnector(credentials_path=str(path)), "new@gmail.com")
+    assert GmailIMAPConnector(credentials_path=str(path)).accounts() == [
+        "old@gmail.com",
+        "new@gmail.com",
+    ]
